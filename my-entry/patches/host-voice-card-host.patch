+/// What the shell can do for a contained app: the host services. Registered
+/// once, process-wide, and offered only to apps whose manifest grants the
+/// family.
+///
+/// `llm` is language models and voice. The key lives in this process's
+/// environment and stays here; a card asks a question and gets an answer
+/// back, and the speaker and the microphone belong to this process too.
+fn register_host_services() {
+    octosense_llm_service::register();
+    let status = octosense_llm_service::Config::from_env();
+    if status.ready() {
+        log!(
+            "card-host: llm service ready — {} at {} (key from {})",
+            status.model,
+            status.endpoint,
+            status.source,
+        );
+    } else {
+        log!(
+            "card-host: llm service registered without a key — set OCTOS_LLM_KEY to answer cards that ask for one",
+        );
+    }
+}
+
+/// One audio output, installed once, reading whatever the voice service has
+/// queued. A card cannot hold a device; `llm.speak` renders a sentence and
+/// this callback is where it becomes sound.
+fn install_audio_output(cx: &mut Cx) {
+    cx.audio_output(0, move |info, output| {
+        output.zero();
+        let frames = output.frame_count();
+        let channels = output.channel_count();
+        if frames == 0 || channels == 0 {
+            return;
+        }
+        let player = octosense_llm_service::voice::player();
+        if !player.state().playing {
+            return;
+        }
+        let mut mono = vec![0.0f32; frames];
+        player.fill(&mut mono, info.sample_rate.max(1.0));
+        // The engine renders mono; every output channel gets the same frames.
+        let mut interleaved = vec![0.0f32; frames * channels];
+        for frame in 0..frames {
+            for channel in 0..channels {
+                interleaved[frame * channels + channel] = mono[frame];
+            }
+        }
+        output.copy_from_interleaved(channels, &interleaved);
+    });
+}
