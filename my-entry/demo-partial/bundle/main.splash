// Morning Brief - 晨报卡（Agentic App 2026 初赛作品）
let sources = [
    {id: "hn" label: "Hacker News" host: "hn.algolia.com" note: "首页热榜 30 条" kind: "hn" url: "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=30"}
    {id: "techmeme" label: "TechMeme" host: "www.techmeme.com" note: "最新条目" kind: "digest" url: "https://www.techmeme.com/definitely-not-a-real-feed.xml"}
]
let topics = [
    {id: "ai" label: "AI" en: "(\\W|^)(AI|GPT|LLM|OpenAI|Anthropic|DeepMind|Gemini|Claude)(\\W|$)" zh: "人工智能|大模型|机器学习"}
    {id: "oss" label: "开源" en: "(\\W|^)(open source|opensource|Linux|kernel|GitHub|Apache)(\\W|$)" zh: "开源"}
    {id: "sec" label: "安全" en: "(\\W|^)(security|vulnerability|breach|malware|ransomware|exploit|CVE)(\\W|$)" zh: "安全|漏洞"}
    {id: "chip" label: "芯片" en: "(\\W|^)(chip|chips|semiconductor|GPU|silicon|TSMC|Nvidia|wafer)(\\W|$)" zh: "芯片|半导体"}
]
let chosen = {ai: true oss: true sec: false chip: false}
let limit = 10
let phase = "intent"
let failed = []
let picked = []
let ok_sources = []
let all_rows = []
let finished_at = 0
let last_rows = []
let last_at = 0
let busy = false
let months = ["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"]
let days = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]

fn fetch(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        if hit.title == nil || hit.title == "" { continue }
        let discussion = "https://news.ycombinator.com/item?id=" + hit.objectID
        let link = discussion
        if hit.url != nil && hit.url != "" { link = hit.url }
        let published = 0
        if hit.created_at_i != nil { published = hit.created_at_i }
        out.push({id: "hn-" + hit.objectID title: hit.title link: link source: "Hacker News" published: published})
    }
    out
}

fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for i it in items {
        if it.title == nil || it.title == "" { continue }
        let source = it.source
        if source == "" { source = s.label }
        let published = 0
        if it.published != nil { published = it.published }
        out.push({id: s.id + "-" + i title: it.title link: it.link source: source published: published})
    }
    out
}

fn load_source(s){
    let res = fetch(s.url).await()
    if res == nil || res.status_code >= 400 || res.body == nil {
        failed.push(s.label)
        return
    }
    let body = res.body.to_string()
    let rows = nil
    if s.kind == "hn" { rows = hn_rows(body) } else { rows = feed_rows(body, s) }
    if rows == nil || rows.len() == 0 {
        failed.push(s.label)
        return
    }
    ok_sources.push({label: s.label n: rows.len()})
    for r in rows { all_rows.push(r) }
}

fn topic_hit(t, title){
    if regex(t.en, "i").test(title) { return true }
    regex(t.zh, "i").test(title)
}

fn topic_on(id){
    if id == "ai" { return chosen["ai"] }
    if id == "oss" { return chosen["oss"] }
    if id == "sec" { return chosen["sec"] }
    chosen["chip"]
}

fn row_hit(title){
    let n = 0
    for t in topics { if topic_on(t.id) { n = n + 1 } }
    if n == 0 { return true }
    for t in topics {
        if topic_on(t.id) && topic_hit(t, title) { return true }
    }
    false
}

fn sort_desc(rows){
    let out = []
    for r in rows {
        let placed = false
        let next = []
        for o in out {
            if !placed && r.published > o.published {
                next.push(r)
                placed = true
            }
            next.push(o)
        }
        if !placed { next.push(r) }
        out = next
    }
    out
}

fn run_brief(){
    if busy { return }
    busy = true
    all_rows = []
    ok_sources = []
    failed = []
    for s in sources { load_source(s) }
    let hits = []
    for r in all_rows { if row_hit(r.title) { hits.push(r) } }
    hits = sort_desc(hits)
    picked = []
    for i r in hits { if i < limit { picked.push(r) } }
    finished_at = time_now()
    if picked.len() > 0 {
        fs.write("last_brief.json", {ts: finished_at rows: picked}.to_json())
        last_rows = picked
        last_at = finished_at
    } else if failed.len() < sources.len() {
        fs.write("last_brief.json", {ts: finished_at rows: []}.to_json())
        last_rows = []
        last_at = finished_at
    }
    phase = "done"
    busy = false
    sync_ui()
}

fn load_last(){
    if fs.exists("last_brief.json") {
        let v = fs.read("last_brief.json").parse_json()
        if v != nil && v.rows != nil {
            last_rows = v.rows
            last_at = v.ts
        }
    }
}

fn make_plan(){
    phase = "plan"
    sync_ui()
}

fn approve(){
    phase = "fetching"
    sync_ui()
    start_timeout(0.05, || run_brief())
}

fn deny(){
    phase = "denied"
    sync_ui()
}

fn restart(){
    phase = "intent"
    picked = []
    failed = []
    ok_sources = []
    all_rows = []
    sync_ui()
}

fn toggle_topic(id){
    if id == "ai" { if chosen["ai"] { chosen["ai"] = false } else { chosen["ai"] = true } }
    else if id == "oss" { if chosen["oss"] { chosen["oss"] = false } else { chosen["oss"] = true } }
    else if id == "sec" { if chosen["sec"] { chosen["sec"] = false } else { chosen["sec"] = true } }
    else { if chosen["chip"] { chosen["chip"] = false } else { chosen["chip"] = true } }
    sync_ui()
}

fn bump(d){
    limit = limit + d
    if limit < 3 { limit = 3 }
    if limit > 30 { limit = 30 }
    sync_ui()
}

fn topics_line(){
    let out = ""
    for t in topics {
        if topic_on(t.id) {
            if out != "" { out = out + "、" }
            out = out + t.label
        }
    }
    if out == "" { return "未选主题（全部放行）" }
    out
}

fn hosts_line(){
    let out = ""
    for s in sources {
        if out != "" { out = out + "、" }
        out = out + s.host
    }
    out
}

fn sources_line(){
    if ok_sources.len() == 0 { return "无" }
    let out = ""
    for s in ok_sources {
        if out != "" { out = out + " · " }
        out = out + s.label + " " + s.n + " 条"
    }
    out
}

fn chip_label(id){
    let label = id
    for t in topics { if t.id == id { label = t.label } }
    if topic_on(id) { return "[x] " + label }
    "[ ] " + label
}

fn full_intent(){
    "给我今天的科技晨报，只要 " + topics_line() + " 相关，" + limit + " 条以内。"
}

fn pad2(n){
    if n < 10 { return "0" + n }
    "" + n
}

fn gen_time(){
    if finished_at <= 0 { return "尚未生成" }
    let t = local_time(time_now() + 28800)
    days[t.weekday] + " " + months[t.month - 1] + " " + t.day + "  " + pad2(t.hour) + ":" + pad2(t.minute)
}

fn ago(secs){
    if secs == nil || secs <= 0 { return "" }
    let d = time_now() - secs
    if d < 60 { return "just now" }
    if d < 3600 { return "" + floor(d / 60) + "m ago" }
    if d < 86400 { return "" + floor(d / 3600) + "h ago" }
    "" + floor(d / 86400) + "d ago"
}

fn row_meta(r){
    let line = r.source
    let a = ago(r.published)
    if a != "" { line = line + "  ·  " + a }
    line
}

fn status_line(){
    if phase == "fetching" { return "正在获取 " + sources.len() + " 个来源…" }
    if phase == "done" {
        if failed.len() == 0 { return "已完成。" }
        if failed.len() < sources.len() { return "部分完成。" }
        return "未能获取任何来源。"
    }
    ""
}

fn fail_line(){
    if failed.len() == 0 { return "" }
    let out = "失败来源："
    for f in failed {
        if out != "失败来源：" { out = out + "、" }
        out = out + f
    }
    if failed.len() == sources.len() { return out + "（全部失败）" }
    out + "（其余来源结果如下，条数未补齐）"
}

fn empty_line(){
    if phase == "fetching" { return "正在获取…" }
    if failed.len() == sources.len() { return "无法获取任何来源。" }
    "未找到符合「" + topics_line() + "」的条目 — 这是筛选结果，不是获取失败。"
}

fn stale_line(){
    if failed.len() == sources.len() && last_rows.len() > 0 { return "以下为上次成功结果，" + ago(last_at) + "，已过期" }
    ""
}

fn show_rows(){
    if picked.len() > 0 { return picked }
    if failed.len() == sources.len() && last_rows.len() > 0 { return last_rows }
    []
}

fn pick_row(r){
    ui.sel_line.set_text("已选中（id " + r.id + "）：" + r.title)
}

fn sync_ui(){
    ui.date.set_text(gen_time())
    ui.intent_line.set_text(full_intent())
    ui.chip_ai.set_text(chip_label("ai"))
    ui.chip_oss.set_text(chip_label("oss"))
    ui.chip_sec.set_text(chip_label("sec"))
    ui.chip_chip.set_text(chip_label("chip"))
    ui.limit_label.set_text("" + limit)
    ui.gen_pane.set_visible(phase == "intent")
    ui.plan_pane.set_visible(phase == "plan")
    ui.run_pane.set_visible(phase == "fetching" || phase == "done")
    ui.deny_pane.set_visible(phase == "denied")
    ui.plan_topics.set_text(plan_text())
    ui.plan_limit.set_text("条数上限：" + limit + " 条")
    ui.plan_hosts.set_text("将发起网络请求的域名：" + hosts_line())
    ui.plan_ask.set_text(ask_text())
    ui.status_line.set_text(status_line())
    ui.fail_line.set_text(fail_line())
    ui.st_gen.set_text("生成时间    " + gen_time())
    ui.st_topics.set_text("筛选主题    " + topics_line())
    ui.st_src.set_text("来源        " + sources_line())
    ui.st_count.set_text("命中条数    " + picked.len() + " 条（上限 " + limit + "）")
    ui.stale_line.set_text(stale_line())
    ui.list.render()
}

fn plan_text(){
    let out = "操作计划\n"
    for s in sources { out = out + "  · " + s.label + " - " + s.note + "\n" }
    out + "筛选主题：" + topics_line() + "\n" + "排序：按发布时间从新到旧"
}

fn ask_text(){
    "批准后才会发起网络请求；选择「暂不」则不产生任何请求。"
}

fn boot(){
    load_last()
    sync_ui()
}
start_timeout(0.05, || boot())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #xe0245e
let ground = #xf2f2f7

let ChipBtn = ButtonFlat{height: 32 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 16.0 color: #xffffff color_hover: #xf0f0f5 color_down: #xe5e5ea border_size: 1.0
        border_color: #xd8d8de border_color_hover: #xd8d8de border_color_down: #xd8d8de}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let NumBtn = ButtonFlat{height: 30 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xf0f0f5 color_down: #xe5e5ea border_size: 1.0
        border_color: #xd8d8de border_color_hover: #xd8d8de border_color_down: #xd8d8de}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 15}}
}
let PrimaryBtn = ButtonFlat{height: 42 padding: Inset{left: 18 right: 18}
    draw_bg +: {border_radius: 10.0 color: accent color_hover: #xc81e52 color_down: #ab1a46 border_size: 0.0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 15}}
}
let GhostBtn = ButtonFlat{height: 42 padding: Inset{left: 18 right: 18}
    draw_bg +: {border_radius: 10.0 color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 1.0
        border_color: #c8c8d0 border_color_hover: #c8c8d0 border_color_down: #c8c8d0}
    draw_text +: {color: #x3a3a3c color_hover: #x3a3a3c color_down: #x3a3a3c text_style +: {font_size: 15}}
}
let RowCard = RoundedView{width: Fill height: Fit flow: Down spacing: 3
    padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 10.0
    rm := Label{width: Fill text: "" max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 10}
    rt := Label{width: Fill text: "" max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: ground
        ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 14 right: 14 top: 14 bottom: 28}
            View{width: Fill height: Fit flow: Down spacing: 2
                date := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
                Label{width: Fill text: "晨报卡" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 28}}
            }
            intent_line := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
            View{width: Fill height: Fit flow: Right spacing: 6
                chip_ai := ChipBtn{text: "AI" on_click: || toggle_topic("ai")}
                chip_oss := ChipBtn{text: "开源" on_click: || toggle_topic("oss")}
                chip_sec := ChipBtn{text: "安全" on_click: || toggle_topic("sec")}
                chip_chip := ChipBtn{text: "芯片" on_click: || toggle_topic("chip")}
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                Label{text: "条数上限" draw_text.color: secondary draw_text.text_style.font_size: 12}
                NumBtn{text: "-" on_click: || bump(-1)}
                limit_label := Label{text: "10" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                NumBtn{text: "+" on_click: || bump(1)}
            }
            gen_pane := View{width: Fill height: Fit
                PrimaryBtn{text: "生成晨报" on_click: || make_plan()}
            }
            plan_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                Label{width: Fill text: "待批准的 Agent 计划" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 12}}
                plan_topics := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                plan_limit := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                plan_hosts := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                plan_ask := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
                View{width: Fill height: Fit flow: Right spacing: 8
                    PrimaryBtn{text: "批准并取数" on_click: || approve()}
                    GhostBtn{text: "暂不" on_click: || deny()}
                }
            }
            run_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                status_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                fail_line := Label{width: Fill text: "" draw_text.color: #xc0392b draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Down spacing: 4
                    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 12.0
                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    st_gen := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    st_topics := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    st_src := Label{width: Fill text: "" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    st_count := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                }
                stale_line := Label{width: Fill text: "" draw_text.color: #xb26a00 draw_text.text_style.font_size: 12}
                list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                    if show_rows().len() == 0 {
                        View{width: Fill height: 80 align: Align{x: 0.5 y: 0.5}
                            Label{text: empty_line() draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                    }
                    else for r in show_rows() {
                        GestureView{width: Fill height: Fit on_tap: |x, y| pick_row(r)
                            RowCard{rm.text: row_meta(r) rt.text: r.title}
                        }
                    }
                }}
                sel_line := Label{width: Fill text: "点击任意条目可核对标题与来源。" draw_text.color: secondary draw_text.text_style.font_size: 11}
                View{width: Fill height: Fit flow: Right
                    GhostBtn{text: "重新开始" on_click: || restart()}
                }
            }
            deny_pane := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                new_batch: true show_bg: true draw_bg.color: #xfff6e5 draw_bg.border_radius: 12.0
                padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                Label{width: Fill text: "已取消 — 未发起任何网络请求。" draw_text.color: #xb26a00 draw_text.text_style: theme.font_bold{font_size: 13}}
                Label{width: Fill text: "你的授权是取数的前提；拒绝后不会读取任何来源。" draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right
                    GhostBtn{text: "重新开始" on_click: || restart()}
                }
            }
        }
    }
    tile: View{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 6
        new_batch: true show_bg: true draw_bg.color: #xffffff
        Label{text: "晨报卡" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
        Label{width: Fill text: "一句话意图，生成一份可核验的晨报。" max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 12}
    }
}