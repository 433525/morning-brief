    if report_focus != "compose" { report_activate("compose") }
    brief_epoch = brief_epoch + 1
    report_live = ""
    report_serial = ""
    busy = false
    phase = "intent"
    cover_on = false
    cover_url = ""
    cover_head = ""
    cover_state = ""
    cover_note = ""
    cover_q = "" vd_reset()
    picked = []
    failed = []
    ok_sources = []
    all_rows = []
    cand = []
    cand_n = 0
    ai_on = false
    ai_state = ""
    ai_intro = ""
    ai_note = ""
    ai_think = ""
    ai_whys = []
    panel = []
    panel_state = ""
    panel_note = ""
    panel_sig = ""
    fc_items = []
    fc_state = ""
    fc_note = ""
