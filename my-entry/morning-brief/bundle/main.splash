    draw_text +: {color: #x61776b color_hover: #x31584c color_down: #x31584c text_style.font_size: 11}
}
let BarBtn = WaterBtn{height: 36 padding: Inset{left: 10 right: 10} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {hover: instance(0.0) down: instance(0.0) pixel: fn(){
        let sz = self.rect_size
        let sdf = Sdf2d.viewport(self.pos * sz)
        sdf.box(1.0, 1.0, sz.x - 2.0, sz.y - 2.0, min(20.0, sz.y * 0.5 - 1.0))
        let d = length(self.pos * sz - sz * 0.5)
        let reach = max(sz.x, sz.y) * 0.75
        let h = self.hover
        let k = self.down
        let ha = 4.0 * h * (1.0 - h)
        let ka = 4.0 * k * (1.0 - k)
        let hr = exp(-pow((d - h * reach) / 8.0, 2.0)) * ha
        let kr = exp(-pow((d - k * reach) / 7.0, 2.0)) * ka
        var c = #xfffaf100
        c = c.mix(#xf0e6d3, h * 0.55)
        c = c.mix(#x6eaa98, clamp(hr * 0.22 + kr * 0.32, 0.0, 1.0))
        c = c.mix(#xffffff, clamp(kr * 0.45, 0.0, 1.0))
        sdf.fill(c)
        sdf.stroke(#xfffaf100.mix(#x588b7f, h), 1.0)
        return sdf.result
    }}
    draw_text +: {color: #xa65b39 color_hover: #xa65b39 color_down: #xa65b39 text_style.font_size: 12}
}
