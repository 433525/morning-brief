        let kr = exp(-pow((d - k * reach) / 8.0, 2.0)) * 4.0 * k * (1.0 - k)
        var c = #xf2aa5b.mix(#xffd590, self.pos.x)
        c = c.mix(#xffe7b6, h * 0.2)
        c = c.mix(#xfffaf1, clamp(hr * 0.25 + kr * 0.65, 0.0, 1.0))
        sdf.fill(c)
        sdf.stroke(#xde9f5c, 1.0)
        return sdf.result
    }}
    draw_text +: {color: #x294137 color_hover: #x294137 color_down: #x294137 text_style: theme.font_bold{font_size: 15}}
}
