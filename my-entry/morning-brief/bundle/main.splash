}

fn set_ask(t){
    ask = t
    ui.intent_line.set_text(intent_preview())
}

fn toggle_topic(id){
    // 品类表可扩，别再写成一串 if/else。
    if chosen[id] == true { chosen[id] = false } else { chosen[id] = true }
    sync_ui()
}

fn toggle_plat(id){
    if chosen_plat[id] == true { chosen_plat[id] = false } else { chosen_plat[id] = true }
    sync_ui()
}

fn bump(d){
    limit = limit + d
    if limit < 3 { limit = 3 }
    if limit > 30 { limit = 30 }
    sync_ui()
}

let cover_shape = {type: "object" required: ["headline" "image"] properties: {headline: {type: "string"} image: {type: "string"}}}

fn cover_kick(){
    if picked.len() == 0 { return }
    if cover_on { return }
    cover_state = "asking"
    cover_note = "视觉主编正在为今天这一期写头版标语…"
    sync_ui()
    if ai_ready != 1 { cover_fallback()
        return }
    let lines = ""
    let i = 1
    for r in picked {
        if i < 9 { lines = lines + "" + i + ". " + r.title + "\n" }
        i = i + 1
    }
    let intro = ai_intro
    if intro == "" { intro = "（这期没有导语）" }
    brief_request("model.complete", {
        task: "[编辑部宪法 cover/" + charter_v("cover") + "]
你是报纸头版的视觉主编，负责为每天一期的科技晨报定头版标题和主画面。直接输出 JSON 对象，第一个字符就是 {，不要输出任何推理过程。JSON 结构：headline 是英文头版大标题（字符串，不超过 9 个词，全大写，不带引号），image 是英文画面描述（字符串，报纸插画风格，不含任何文字）。"
        input: "今天是 " + today_text() + "。\n本期晨报导语：" + intro + "\n今日入选标题（按重要性排序）：\n" + lines + "\n请为这一期设计头版：headline 写一句英文大标题，概括今天最重要的主题；image 写一句英文画面描述，用来画头版主图。"
        schema: cover_shape
        class: "strong"
        allow_urls: true
    }, fn(r){
        let good = false
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.headline != nil && r.data.output.image != nil { good = true }
        if good {
            cover_head = "" + r.data.output.headline
            if trail.len() > 0 {
                let cv = trail["cover"]
                cv["headline"] = cover_head
                cv["state"] = "ok"
                trail["cover"] = cv
                trail_save()
            }
            cover_q = "front page newspaper editorial illustration, " + r.data.output.image + ", bold iconic composition, dramatic but tasteful, 16:9, no text, no letters, no watermark"
            cover_state = "drawing"
            cover_note = "头版标语已定，正在画头版主图…"
            sync_ui()
            start_timeout(0.05, || cover_draw())
        } else {
            cover_fallback()
        }
    })
}

fn cover_fallback(){
    let t = ""
    let i = 0
    for r in picked {
        if i == 0 { t = r.title }
        i = i + 1
    }
    if t == "" { t = "今天的科技新闻" }
    cover_head = art_cut(t, 56)
    cover_q = "front page newspaper editorial illustration ABOUT THIS STORY: " + art_cut(t, 300) + " -- iconic front page art, dramatic but tasteful, 16:9, no text, no letters, no watermark"
    cover_state = "drawing"
    cover_note = "视觉主编这次没答复，已按头条标题兜底画头版"
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

fn cover_draw(){
    let u = photo_take(cover_q)
    if u == nil || u == "" {
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    let pic = ("" + u).trim()
    if art_is_photo(pic) == false {
        cover_state = "failed"
        cover_note = "这次没能画出头版图，文字内容不受影响。"
        sync_ui()
        return
    }
    cover_seed = cover_seed + 1
    cover_url = pic + "&seed=" + cover_seed
    cover_on = true
    cover_state = "ok"
    cover_note = "视觉主编头版"
    cover_save()
    sync_ui()
}

fn cover_retry(){
    if cover_q == "" {
        cover_fallback()
        return
    }
    cover_state = "drawing"
    cover_note = "正在重画头版，请稍等…"
    sync_ui()
    start_timeout(0.05, || cover_draw())
}

fn cover_save(){
    fs.write("cover.json", {ts: last_at head: cover_head url: cover_url q: cover_q}.to_json())
}

fn cover_line(){
    if cover_state == "ok" { return "官方画图能力生成 · 换一张会重新画" }
    cover_note
}


// =====================================================================
// 第 37 轮 · 水面上的浏览器（Waterfront）
// ---------------------------------------------------------------------
// 这一轮只做三件事，但每一件都对着一个具体的毛病：
//
// ① 顶部横幅 = 真正的标签栏。五个格子：头版 / 情报池 / 复盘 / 立场 / 读稿。
//    旧的毛病：切到某个栏目时那块内容是空的，而可见性是一次性写死的，
//    于是整屏什么都不剩（白屏），只能退出重开。现在可见性只由 sync_tabs() 决定，
//    它永远「五选一」，并且自己会把不成立的标签收回 —— 没有「全部隐藏」这条路。
// ② 清晨水面材质：划过是微澜，按下是同心波纹；整屏有晨光微尘与水波折光。
// ③ 守夜人：每 0.5 秒重落一次可见性。任何一条文案读不出来，只影响那一条，
//    并且自愈的事会如实写在标签栏下面 —— 故障也是过程的一部分。
// =====================================================================
// 第 42 轮：日报是文档；栏目只是文档内的导航。编辑中的工作台与已保存日报分离。
let reports = []
let report_open = []
let report_focus = "compose"
let report_sessions = {}
let report_live = ""
let report_serial = ""
let report_rail_key = ""
let report_body_key = ""
let report_revision = 0
let report_save_tid = nil
let report_shelf_on = false
let report_query = ""
let report_last_closed = ""
let report_read_ids = []
let ui_refresh_tid = nil
let report_storage_lock = false
let report_recovery_raw = ""
let brief_epoch = 0
let story_epoch = 0
let bar_tid = nil
let quiet_motion = false
let water_y = 0.6

fn list_of(o, k){
    if !object_like(o) { return [] }
    let v = o[k]
    if v == nil { return [] }
    if v.to_json().search("[") != 0 { return [] }
    v
}

fn num_of(o, k){
    if !object_like(o) { return 0 }
    let v = o[k]
    if v == nil { return 0 }
    if !regex("^[0-9]+([.][0-9]+)?$", "").test(v.to_json()) { return 0 }
    v
}

fn report_rows(raw){
    let out = []
    for i r in raw {
        if r == nil { continue }
        if r.to_json().search("{") != 0 { continue }
        let title = s_of(r, "title")
        if title == "" { continue }
        let rr = r.to_json().parse_json()
        let rid = s_of(r, "id")
        if rid == "" { rid = "saved-" + ("" + i) }
        rr["id"] = rid
        rr["title"] = title
        rr["link"] = s_of(r, "link")
        rr["source"] = s_of(r, "source")
        rr["summary"] = s_of(r, "summary")
        rr["image"] = s_of(r, "image")
        rr["discussion"] = s_of(r, "discussion")
        rr["published"] = num_of(r, "published")
        rr["points"] = nil
        rr["comments"] = nil
        if r["points"] != nil { rr["points"] = num_of(r, "points") }
        if r["comments"] != nil { rr["comments"] = num_of(r, "comments") }
        out.push(rr)
    }
    out
}

fn report_find(id){
    for d in reports { if s_of(d, "id") == id { return d } }
    nil
}

fn report_current(){
    if report_focus == "compose" { return nil }
    report_find(report_focus)
}

fn report_text(key, fallback){
    let d = report_current()
    if d == nil { return fallback }
    let v = d[key]
    if v == nil { return fallback }
    "" + v
}

fn report_stamp(ts){
    let d = local_time(ts + 28800)
    sky_pad(d.month) + "/" + sky_pad(d.day) + " " + sky_pad(d.hour) + ":" + sky_pad(d.minute)
}

fn report_label(id){
    let d = report_find(id)
    if d == nil { return "已保存日报" }
    let ts = num_of(d, "ts")
    if ts <= 0 { return "已保存日报" }
    report_stamp(ts)
}

fn report_has_open(id){
    for x in report_open { if x == id { return true } }
    false
}

fn report_schedule_save(){
    if report_save_tid == nil { report_save_tid = start_timeout(0.35, || report_save()) }
}

fn report_save(){
    report_save_tid = nil
    if report_storage_lock {
        heal_note("原档案无法读取且未能备份；为保护原件，暂不覆盖保存，当前页面仍可使用")
        return
    }
    try {
        // 保存当下这一页，不等到读者切走才补记阅读位置。
        report_sessions[report_focus] = report_reader_snapshot()
        fs.write("reports.json", {schema: 1 reports: reports open: report_open focus: report_focus sessions: report_sessions quiet: quiet_motion closed: report_last_closed}.to_json())
    } catch { heal_note("日报页签暂未保存；当前页面仍然可用") }
}

fn report_snapshot(rows, ts){
    {id: "issue-" + ("" + floor(ts * 1000.0)) ts: ts rows: rows intro: ai_intro whys: ai_whys
        cover_url: cover_url cover_head: cover_head cover_note: cover_note
        sources: src_line() failures: fail_line() work: work_line() tiers: tier_line()
        pool_head: live_pool_head_text() pool_rows: live_pool_rows_text() pool_panel: live_pool_panel_text() pool_work: live_pool_work_text()
        review_head: live_review_head_text() review_time: live_review_time_text() review_fc: live_review_fc_text()
        stand_head: live_stand_head_text() stand_ledger: live_stand_ledger_text() stand_creed: live_stand_creed_text()
        forecast: fc_items fixes: fix clashes: clash drops: drop decisions: vd_rows
    }
}

fn report_put(d){
    let id = s_of(d, "id")
    let at = -1
    for i x in reports { if s_of(x, "id") == id { at = i } }
    if at < 0 { reports.push(d) } else { reports[at] = d }
    report_revision = report_revision + 1
    // 本机 16MB 配额：只淘汰未打开的最早文档，不突然关闭读者正在看的页签。
    if reports.len() > 24 {
        let drop_at = -1
        for i x in reports {
            if drop_at < 0 && !report_has_open(s_of(x, "id")) { drop_at = i }
        }
        if drop_at >= 0 { reports.remove(drop_at) }
    }
}

fn report_publish(){
    if picked.len() == 0 { return }
    let d = report_snapshot(picked, finished_at).to_json().parse_json()
    report_live = s_of(d, "id")
    report_serial = d.to_json()
    report_put(d)
    if !report_has_open(report_live) { report_open.push(report_live) }
    report_activate(report_live)
    report_schedule_save()
}

fn report_reconcile(){
    if report_live == "" || picked.len() == 0 || phase != "done" { return }
    let data = report_snapshot(picked, finished_at).to_json()
    if data == report_serial { return }
    report_serial = data
    report_put(data.parse_json())
    report_schedule_save()
}

fn report_reader_snapshot(){
    let session = {tab: active_tab row: story title: story_title meta: story_meta sum: story_sum more: story_more comments: story_comments
        ai: story_ai state: story_state error: story_err art_url: art_url art_note: art_note art_on: art_on relations: arc_rel
        voice_q: rv_q voice_i: rv_i read_ids: report_read_ids}
    session.to_json().parse_json()
}

fn report_reader_save(){
    report_sessions[report_focus] = report_reader_snapshot()
    report_schedule_save()
}

fn report_reader_apply(){
    story_epoch = story_epoch + 1
    if bar_tid != nil { stop_timer(bar_tid) bar_tid = nil }
    bar_p = 1.0
    story_tab_text = ""
    art_busy = false
    art_q = ""
    art_pending = ""
    story = nil
    story_title = ""
    story_meta = ""
    story_sum = ""
    story_more = []
    story_comments = []
    story_ai = ""
    story_err = ""
    story_state = ""
    art_url = ""
    art_on = false
    art_note = ""
    arc_rel = []
    active_tab = "front"
    tab_from = 0.0 tab_to = 0.0 tab_p = 1.0
    story_tab = false
    rv_on = false
    rv_q = []
    rv_i = 0
    let v = report_sessions[report_focus]
    report_read_ids = []
    if v == nil { return }
    // 一份阅读会话损坏，只回到这一份日报的头版；绝不丢掉全部日报。
    if !object_like(v) { heal_note("这份日报的阅读位置无法恢复，正文与其他页签均已保留") return }
    for id in list_of(v, "read_ids") {
        if id != nil && id.to_json().search("\"") == 0 { report_read_ids.push(id) }
    }
    let t = s_of(v, "tab")
    if t == "pool" || t == "review" || t == "stand" { active_tab = t }
    let r = v["row"]
    if r == nil { return }
    let safe = report_rows([r])
    if safe.len() == 0 { return }
    story = safe[0]
    story_title = s_of(v, "title")
    if story_title == "" { story_title = story.title }
    story_meta = s_of(v, "meta")
    story_sum = s_of(v, "sum")
    story_more = list_of(v, "more")
    story_comments = list_of(v, "comments")
    story_ai = s_of(v, "ai")
    story_state = s_of(v, "state")
    story_err = s_of(v, "error")
    art_url = s_of(v, "art_url")
    art_note = s_of(v, "art_note")
    art_on = art_url != ""
    arc_rel = list_of(v, "relations")
    if story_state == "loading" || story_state == "ai" {
        story_state = "fail"
        story_err = "已保留离开时的阅读内容；点「更新解读」可继续，旧请求不会串到这一页。"
    }
    story_tab = true
    story_tab_text = art_cut(story_title, 4)
    if t == "story" { active_tab = "story" }
    rv_q = list_of(v, "voice_q")
    rv_i = num_of(v, "voice_i")
}

fn report_activate(id){
    if id != "compose" && report_find(id) == nil { return }
    if id == report_focus { return }
    report_reader_save()
    report_focus = id
    report_reader_apply()
    report_body_key = ""
    report_shelf_on = false
    water_touch(0.5, 0.62)
    sync_tabs()
    queue_ui()
    report_schedule_save()
}

fn report_open_issue(id){
    if report_find(id) == nil { return }
    if !report_has_open(id) { report_open.push(id) }
    report_shelf_on = false
    report_activate(id)
    sync_ui()
    report_schedule_save()
}

fn report_close(id){
    let at = -1
    for i x in report_open { if x == id { at = i } }
    if at < 0 { return }
    if report_focus == id { report_reader_save() }
    report_last_closed = id
    report_open.remove(at)
    if report_focus == id {
        let next = "compose"
        if report_open.len() > 0 {
            let n = min(at, report_open.len() - 1)
            next = report_open[n]
        }
        report_activate(next)
    }
    report_schedule_save()
    sync_ui()
}

fn report_new(){
    report_activate("compose")
    brief_epoch = brief_epoch + 1
    story_epoch = story_epoch + 1
    busy = false
    report_live = ""
    report_serial = ""
    story = nil
    story_tab = false
    active_tab = "front"
    restart()
    water_touch(0.5, 0.55)
}

fn report_search(t){
    report_query = t
    // 只更新结果区，搜索框与中文输入位置保持不动。
    ui.report_catalog.render()
}

fn report_reopen_last(){
    let id = report_last_closed
    if id == "" || report_find(id) == nil { return }
    report_last_closed = ""
    report_open_issue(id)
}

fn report_shelf_toggle(){
    report_shelf_on = !report_shelf_on
    ui.report_catalog.render()
    ui.report_reopen.set_visible(report_last_closed != "")
    sync_tabs()
}

fn report_recover_file(){
    if !report_storage_lock || report_recovery_raw == "" { return }
    let backup = "reports.recovery-" + ("" + floor(time_now() * 1000.0)) + ".json"
    if fs.exists(backup) { return }
    try {
        fs.write(backup, report_recovery_raw)
        report_storage_lock = false
        report_recovery_raw = ""
        heal_note("原档案无法解析，损坏原件已另存备份；可继续使用工作台")
    } catch {
        heal_note("档案无法恢复且备份失败，已停止覆盖保存，原件保持不动")
    }
}

fn report_load(){
    if fs.exists("reports.json") {
        report_storage_lock = true
        report_recovery_raw = fs.read("reports.json")
        let v = report_recovery_raw.parse_json()
        // 只有确认读到了对象才解除保护；解析中断也由 boot 在外层处理。
        if !object_like(v) { return }
        report_storage_lock = false
        report_recovery_raw = ""
        if v != nil {
            for d in list_of(v, "reports") {
                if d == nil || d.to_json().search("{") != 0 { continue }
                if s_of(d, "id") == "" || num_of(d, "ts") <= 0 { continue }
                let rows = report_rows(list_of(d, "rows"))
                if rows.len() == 0 { continue }
                d["rows"] = rows
                report_put(d)
            }
            for id in list_of(v, "open") {
                if report_find(id) != nil && !report_has_open(id) { report_open.push(id) }
            }
            let sessions = v["sessions"]
            if sessions != nil && sessions.to_json().search("{") == 0 { report_sessions = sessions }
            let q = v["quiet"]
            if q != nil { quiet_motion = q == true }
            let closed = s_of(v, "closed")
            if report_find(closed) != nil { report_last_closed = closed }
            let focus = s_of(v, "focus")
            if focus == "compose" || report_find(focus) != nil { report_focus = focus }
        }
    }
    // 迁移原来唯一的 last_brief，不伪造不存在的往期，不改旧文件。
    if reports.len() == 0 && last_rows.len() > 0 && last_at > 0 {
        let d = report_snapshot(report_rows(last_rows), last_at).to_json().parse_json()
        report_put(d)
        let id = s_of(d, "id")
        report_open.push(id)
        report_focus = id
        report_schedule_save()
    }
    if report_focus != "compose" && !report_has_open(report_focus) { report_open.push(report_focus) }
    report_reader_apply()
}

fn report_sync(){
    if tab_tid == nil { tab_to = tab_slot(active_tab) tab_from = tab_to tab_p = 1.0 ui.nav_waterline.render() }
    ui.motion_toggle.set_text(quiet_label())
    let key = report_focus + report_open.to_json() + ("" + quiet_motion) + phase
    if key != report_rail_key {
        report_rail_key = key
        ui.report_tabs.render()
    }
    ui.report_shelf.set_visible(report_shelf_on)
    if active_tab == "front" && report_focus != "compose" {
        let d = report_current()
        // 不在每次守护检查中序列化整份日报：长时间使用也不反复分配大对象。
        let body_key = report_focus + "/" + ("" + report_revision)
        if body_key != report_body_key {
            report_body_key = body_key
            ui.report_body.render()
        }
    }
}

fn quiet_toggle(){
    quiet_motion = !quiet_motion
    if quiet_motion {
        water_pulse = 0.0
        if water_tid != nil { stop_timer(water_tid) water_tid = nil }
        if tab_tid != nil { stop_timer(tab_tid) tab_tid = nil }
        if bar_tid != nil { stop_timer(bar_tid) bar_tid = nil }
        if sky_tid != nil { stop_timer(sky_tid) sky_tid = nil }
        bar_p = 1.0
        sky_goal()
        sky_h = sky_h_to
        sky_r = sky_r_to
        ui.sky.render()
        ui.story_sheen.render()
        if !cg_done { cg_off() }
        tab_p = 1.0
        tab_swell = 0.0
    }
    report_schedule_save()
    ui.motion_toggle.set_text(quiet_label())
    report_rail_key = ""
    sync_ui()
}

// 跨文档切换不改工作台的取数状态；已取消的旧任务、旧阅读请求不能写入新页面。
fn brief_request(route, args, cb){
    let token = brief_epoch
    host.request(route, args, fn(reply){
        if token != brief_epoch { return }
        try { cb(reply) } catch { sync_break() }
    })
}

fn reader_request(route, args, cb){
    let token = story_epoch
    host.request(route, args, fn(reply){
        if token != story_epoch || story == nil { return }
        try { cb(reply) } catch {
            story_state = "fail"
            story_err = "解读这次没有完成，已存正文与其他日报仍然可用。"
            sync_ui()
        }
    })
}

fn story_refresh(){
    if story == nil { return }
    let r = story
    open_story(r)
}

fn quiet_label(){
    if quiet_motion { return "静谧中" }
    "轻动效"
}

fn compose_text(){
    if busy { return "新报 · 编辑中" }
    "新报"
}

fn report_reason(d, id){
    for w in list_of(d, "whys") { if s_of(w, "id") == id { return s_of(w, "why") } }
    ""
}

// 阅读潮汐：每份日报独立记住打开过的线索，关闭页签不删除日报。
fn report_was_read(id){
    for x in report_read_ids { if x == id { return true } }
    false
}

fn report_mark_read(id){
    if !report_was_read(id) { report_read_ids.push(id) }
    report_body_key = ""
}

fn report_read_line(){
    let d = report_current()
    if d == nil { return "清晨工作台 · 先授权，再取数" }
    let count = 0
    for r in list_of(d, "rows") { if report_was_read(s_of(r, "id")) { count = count + 1 } }
    "阅读潮汐  " + ("" + count) + " / " + ("" + list_of(d, "rows").len()) + "  ·  读到哪里，光就走到哪里"
}

fn report_read_tag(id){
    if report_was_read(id) { return "已打开" }
    "待展开"
}

fn report_shift(direction){
    if report_open.len() == 0 { heal_note("出刊后自动留下独立日报；还没有可切换的往期") return }
    let index = -1
    for i id in report_open { if id == report_focus { index = i } }
    let next = index + direction
    if next < 0 { next = report_open.len() - 1 }
    if next >= report_open.len() { next = 0 }
    report_activate(report_open[next])
}

// 合并快速连续操作，把文案更新放到下一次事件预算里。
fn queue_ui(){
    if ui_refresh_tid != nil { return }
    ui_refresh_tid = start_timeout(0.016, || {
        ui_refresh_tid = nil
        sync_ui()
    })
}


let active_tab = "front"        // front / pool / review / stand / story
let story_tab = false           // 「读稿」这格占着没有
let story_tab_text = ""         // 读稿格子上的短标题（前四个字）
let story_back = "intent"       // 进读稿之前停在哪个阶段，关掉要还回去
let tab_from = 0.0              // 上一格（0..4）
let tab_to = 0.0                // 现在这一格
let tab_p = 1.0                 // 滑动进度 0..1，1 = 停稳
let tab_dir = 1.0               // 往右切 +1 / 往左切 -1
let tab_tid = nil
let tab_swell = 0.0             // 切换时的一次水涌：1 → 0
let watch_tid = nil
let watch_hits = 0
let heal_n = 0                  // 自愈次数（如实写进界面）
let heal_line = ""
let heal_until = 0
let water_t = 0.0
let water_tid = nil
let water_pulse = 0.0           // 每次点按，水面中心泛一下
let water_at = 0.5              // 波纹落在水面的哪个横坐标（0..1）

fn tab_slot(t){
    if t == "front" { return 0.0 }
    if t == "pool" { return 1.0 }
    if t == "review" { return 2.0 }
    if t == "stand" { return 3.0 }
    if t == "story" { return 4.0 }
    0.0
}

fn tab_front_text(){
    if report_current() != nil { return "头版" }
    if phase == "fetching" { return "头版·印" }
    if phase == "refused" { return "头版·休" }
    if phase == "done" || phase == "story" { return "头版" }
    "头版"
}

fn tab_pool_text(){
    let d = report_current()
    if d != nil { return "线索 " + ("" + list_of(d, "rows").len()) }
    if cand.len() > 0 { return "情报池 " + ("" + cand.len()) }
    if picked.len() > 0 { return "情报池 " + ("" + picked.len()) }
    "情报池"
}

fn tab_review_text(){
    if report_current() != nil { return "复盘" }
    if panel.len() > 0 { return "复盘 " + ("" + panel.len()) + "/" + ("" + roles.len()) }
    "复盘"
}

fn tab_stand_text(){
    let d = report_current()
    let n = fix_count() + clash_count()
    if d != nil { n = list_of(d, "fixes").len() + list_of(d, "clashes").len() }
    if n > 0 { return "立场 " + ("" + n) }
    "立场"
}

fn tab_story_text(){
    // 窄屏保持稳定导航名称；文章全标题放在阅读页，不把截断标题塞进栏目。
    if story_tab { return "读稿 ·" }
    "读稿"
}

// 自愈要写在界面上 —— 过程与故障都摊开，是这个应用一贯的立场
fn heal_note(t){
    heal_n = heal_n + 1
    heal_line = "界面自检 · " + t + " · 第 " + ("" + heal_n) + " 次"
    heal_until = time_now() + 10.0
    ui.watch_line.set_text(heal_line)
    ui.watch_toast.set_visible(true)
}

// 任何一条文案读不出来时走这里：只记一笔，界面照旧。
// 可见性在 sync_ui() 的最前面就落定了，所以文案出错 = 少一行字，不是整屏空。
fn sync_break(){
    if heal_line != "" && time_now() < heal_until { return }
    heal_n = heal_n + 1
    heal_line = "界面已保护 · 一段内容暂未更新，其他页面仍可使用 · " + ("" + heal_n)
    heal_until = time_now() + 8.0
}

fn phase_known(){
    if phase == "intent" { return true }
    if phase == "asking" { return true }
    if phase == "plan" { return true }
    if phase == "denied" { return true }
    if phase == "fetching" { return true }
    if phase == "judging" { return true }
    if phase == "refused" { return true }
    if phase == "done" { return true }
    if phase == "story" { return true }
    false
}

fn set_tab(t){
    if t == "story" && !story_tab {
        heal_note("「读稿」要等你先点开一条新闻")
        return
    }
    if t == active_tab {
        sync_tabs()
        return
    }
    let a = tab_slot(active_tab)
    let b = tab_slot(t)
    tab_from = a
    tab_to = b
    tab_p = 0.0
    if b < a { tab_dir = -1.0 } else { tab_dir = 1.0 }
    active_tab = t
    tab_swell = 1.0
    water_pulse = 1.0
    water_at = 0.12 + 0.19 * b
    water_touch(water_at, 0.62)
    if !quiet_motion && tab_tid == nil { tab_tid = start_interval(0.033, || tab_step()) }
    if quiet_motion { tab_p = 1.0 tab_from = tab_to ui.nav_waterline.render() }
    sky_kick()
    sync_tabs()
    queue_ui()
    sync_panes()
    report_reader_save()
}

fn tab_step(){
    tab_p = min(1.0, tab_p + 0.08)
    tab_swell = tab_swell * 0.90
    if tab_swell < 0.02 { tab_swell = 0.0 }
    ui.nav_waterline.render()
    if tab_p >= 1.0 && tab_swell == 0.0  {
        tab_from = tab_to
        if tab_tid != nil { stop_timer(tab_tid) }
        tab_tid = nil
    }
}

// 可见性单点：五个格子，永远有且只有一个内容区亮着
fn sync_tabs(){
    if !phase_known() { phase = "intent" }
    if active_tab != "front" && active_tab != "pool" && active_tab != "review" && active_tab != "stand" && active_tab != "story" { active_tab = "front" }
    if report_focus != "compose" && report_find(report_focus) == nil { report_focus = "compose" active_tab = "front" }
    let document = report_focus != "compose"

    if active_tab == "story" && !(story_tab && story != nil) { active_tab = "front" }
    if story_tab && story == nil { story_tab = false }

    let prep = phase == "intent" || phase == "asking" || phase == "plan" || phase == "judging" || phase == "denied"
    let front = active_tab == "front"
    let story_on = active_tab == "story"
    let paper = phase == "fetching" || phase == "done" || phase == "story"

    ui.tab_front_on.set_text(tab_front_text())
    ui.tab_front_off.set_text(tab_front_text())
    ui.tab_pool_on.set_text(tab_pool_text())
    ui.tab_pool_off.set_text(tab_pool_text())
    ui.tab_review_on.set_text(tab_review_text())
    ui.tab_review_off.set_text(tab_review_text())
    ui.tab_stand_on.set_text(tab_stand_text())
    ui.tab_stand_off.set_text(tab_stand_text())
    ui.tab_story_on.set_text(tab_story_text())
    ui.tab_story_off.set_text(tab_story_text())
    ui.tab_story_on.set_visible(story_on)
    ui.tab_story_off.set_visible(!story_on)

    ui.tab_front_on.set_visible(front)
    ui.tab_front_off.set_visible(!front)
    ui.tab_pool_on.set_visible(active_tab == "pool")
    ui.tab_pool_off.set_visible(active_tab != "pool")
    ui.tab_review_on.set_visible(active_tab == "review")
    ui.tab_review_off.set_visible(active_tab != "review")
    ui.tab_stand_on.set_visible(active_tab == "stand")
    ui.tab_stand_off.set_visible(active_tab != "stand")

    ui.story_pane.set_visible(story_on)
    ui.pool_pane.set_visible(active_tab == "pool")
    ui.review_pane.set_visible(active_tab == "review")
    ui.stand_pane.set_visible(active_tab == "stand")
    ui.report_pane.set_visible(front && document)
    ui.report_shelf.set_visible(report_shelf_on)
    if front && !document {
        ui.browse.set_visible(prep)
        ui.run_pane.set_visible(!prep && paper)
        ui.refuse_pane.set_visible(phase == "refused")
    } else {
        ui.browse.set_visible(false)
        ui.run_pane.set_visible(false)
        ui.refuse_pane.set_visible(false)
    }
    ui.watch_toast.set_visible(heal_line != "")
    report_sync()
}

// 守夜人：每半秒重落一次可见性。它是幂等的，所以哪怕上一拍 sync_ui 中途出错，
// 异常状态被规范化后回到有效页面；此机制不代替实机错误诊断。
fn watch_tick(){
    watch_hits = watch_hits + 1
    if !cg_done && cg_t0 > 0.0 && time_now() - cg_t0 > 3.0 { cg_off() }
    if story_tab && story == nil { story_tab = false }
    if !phase_known() { phase = "intent" active_tab = "front" }
    if heal_line != "" && time_now() > heal_until { heal_line = "" }
    if heal_line != "" {
        ui.watch_line.set_text(heal_line)
        ui.watch_toast.set_visible(true)
    }
    try { sync_tabs() } catch { sync_break() }
}

fn water_touch(x, y){
    if quiet_motion { return }
    water_at = clamp(x, 0.08, 0.92)
    water_y = clamp(y, 0.10, 0.90)
    water_t = 0.0
    water_pulse = 1.0
    if water_tid == nil { water_tid = start_interval(0.033, || field_step()) }
}

fn field_step(){
    water_t = water_t + 0.033
    water_pulse = max(0.0, 1.0 - water_t / 1.05)
    ui.water.render()
    if water_t >= 1.05 || quiet_motion {
        water_pulse = 0.0
        if water_tid != nil { stop_timer(water_tid) }
        water_tid = nil
    }
}

fn go_prep(){
    if report_focus != "compose" { report_activate("compose") }
    active_tab = "front"
    if !(phase == "intent" || phase == "asking" || phase == "plan") { restart() }
    sync_tabs()
}

// ---- 新栏目要念的三段话：都是既有数据，零额外调用 ----


fn pool_head_text(){
    let document = report_current()
    if document != nil { return s_of(document, "pool_head") }
    live_pool_head_text()
}
fn live_pool_head_text(){
    if work_n == 0 {
        if phase == "fetching" { return "正在取数。拿到候选后会按信源等级排在这里 —— 传闻、转载、二手、一手，各占多少。"
        }
        if picked.len() > 0 { return "这一期已经见报 " + ("" + picked.len()) + " 条（来自往期恢复，取数记录不在内存里）。"
        }
        return "今天还没有取数。回到「头版」按下「生成晨报」，批准之后这里会列出每一条候选和它的信源等级。"
    }
    "今天扫了 " + ("" + work_n) + " 条原始条目，" + ("" + work_cand) + " 条进了池子，见报 " + ("" + picked.len()) + " 条。"
}



fn pool_rows_text(){
    let document = report_current()
    if document != nil { return s_of(document, "pool_rows") }
    live_pool_rows_text()
}
fn live_pool_rows_text(){
    if cand.len() == 0 {
        if phase == "fetching" { return "正在取数…" }
        return "池子还是空的。"
    }
    let out = ""
    let i = 0
    for r in cand {
        if i < 16 {
            if out != "" { out = out + "\n" }
            out = out + pad2(i + 1) + "  [" + tier_label(r) + "]  " + row_title(r) + "\n      " + row_src(r)
        }
        i = i + 1
    }
    let rest = cand.len() - 16
    if rest > 0 { out = out + "\n… 还有 " + ("" + rest) + " 条在池子里" }
    out
}



fn pool_panel_text(){
    let document = report_current()
    if document != nil { return s_of(document, "pool_panel") }
    live_pool_panel_text()
}
fn live_pool_panel_text(){
    if panel.len() == 0 {
        if phase == "judging" { return "三位初审正在各自独立地读候选，谁也不看谁的意见…" }
        return "还没有初审意见。出报时三位编辑会背靠背各写一句点评，原话会留在这里。"
    }
    let out = ""
    for p in panel {
        let lb = s_of(p, "label")
        if lb == "" { lb = "初审编辑" }
        let st = s_of(p, "state")
        if out != "" { out = out + "\n" }
        if st == "fail" { out = out + "· " + lb + "：这次没答复" }
        else {
            let dg = s_of(p, "digest")
            if dg == "" { dg = "（这位编辑没有留下点评）" }
            out = out + "· " + lb + "：" + dg
        }
    }
    out
}



fn pool_work_text(){
    let document = report_current()
    if document != nil { return s_of(document, "pool_work") }
    live_pool_work_text()
}
fn live_pool_work_text(){
    let out = ""
    let t1 = tier_line()
    if t1 != "" { out = t1 }
    let t2 = work_line()
    if t2 != "" {
        if out != "" { out = out + "\n" }
        out = out + t2
    }
    let t3 = src_line()
    if t3 != "" {
        if out != "" { out = out + "\n" }
        out = out + t3
    }
    if out == "" { out = "还没有这一期的取数记录。" }
    out
}



fn review_head_text(){
    let document = report_current()
    if document != nil { return s_of(document, "review_head") }
    live_review_head_text()
}
fn live_review_head_text(){
    if replay_text() == "" {
        return "还没有可以回放的过程。出过一期之后，这里会摊开：候选池扫了多少条、三位初审各自的原话、主编终审的取舍理由 —— 零额外 AI 调用，全是本来就要落盘的数据。"
    }
    "这一期是怎么做出来的：候选池 → 三位初审 → 主编终审 → 对账。"
}



fn review_fc_text(){
