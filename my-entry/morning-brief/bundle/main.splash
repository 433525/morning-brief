fn vc_auto_text(){
    if vc_tts {
        if vc_auto { return "自动朗读：开" }
        return "自动朗读：关"
    }
    "语音：不可用"
}

fn art_load(){
    if fs.exists("art_cache.json") {
        let v = fs.read("art_cache.json").parse_json()
        if v != nil && v.items != nil {
            for it in v.items {
                if it.id != nil && it.url != nil && it.url != "" {
                    art_cache.push({id: it.id url: it.url})
                }
            }
        }
    }
}

// =====================================================================
// 破晓 · 天空就是进度条
// ---------------------------------------------------------------------
// 顶部的地平线带在所有阶段都在：日出前（等你开口）太阳还在海平面以下，
// 取数、审稿时一点点升起，出刊那一刻挂在空中。读稿时天空收成一条窄带。
// 高度与日出程度都缓动到目标值（33ms 一帧，收敛即停表，不常驻）。
// =====================================================================
let sky_h = 232.0
let sky_h_to = 232.0
let sky_r = 0.0
let sky_r_to = 0.0
let sky_tid = nil
let sky_first = true
let sky_wk = ["周日" "周一" "周二" "周三" "周四" "周五" "周六"]

fn sky_goal(){
    let h = 178.0
    let r = 0.64
    if phase == "asking" || phase == "plan" { h = 154.0 r = 0.72 }
    if phase == "fetching" || phase == "judging" { h = 134.0 r = 0.82 }
    if phase == "done" || report_focus != "compose" { h = 132.0 r = 1.0 }
    if phase == "refused" { h = 132.0 r = 0.60 }
    if active_tab == "story" { h = 82.0 r = 1.0 }
    if active_tab == "pool" || active_tab == "review" || active_tab == "stand" { h = 108.0 }
    sky_h_to = h
    sky_r_to = r
}

fn home_title_text(){
    if phase == "asking" { return "先回答主编一个问题" }
    if phase == "plan" { return "确认今天的取数计划" }
    if phase == "judging" { return "编辑部正在审稿" }
    if phase == "denied" { return "这次先不取数" }
    "今天想读什么？"
}

fn sky_kick(){
    ui.home_title.set_text(home_title_text())
    ui.setup_box.set_visible(phase == "intent")
    sky_goal()
    if quiet_motion || sky_first {
        sky_first = false
        sky_h = sky_h_to
        sky_r = sky_r_to
        ui.sky.render()
        return
    }
    if abs(sky_h_to - sky_h) < 0.5 && abs(sky_r_to - sky_r) < 0.003 { return }
    if sky_tid == nil {
        sky_tid = start_interval(0.033, || sky_step())
    }
}

fn sky_step(){
    sky_h = sky_h + (sky_h_to - sky_h) * 0.2
    sky_r = sky_r + (sky_r_to - sky_r) * 0.07
    if abs(sky_h_to - sky_h) < 0.5 && abs(sky_r_to - sky_r) < 0.003 {
        sky_h = sky_h_to
        sky_r = sky_r_to
        if sky_tid != nil { stop_timer(sky_tid) }
        sky_tid = nil
    }
    ui.sky.render()
}

fn sky_pad(n){
    let t = "" + n
    if n < 10 { return "0" + t }
    t
}

fn sky_date(){
    let timestamp = time_now()
    let document = report_current()
    if document != nil { timestamp = num_of(document, "ts") }
    let d = local_time(timestamp + 28800)
    let w = ""
    if d.weekday >= 0 && d.weekday < 7 { w = sky_wk[d.weekday] }
    sky_pad(d.month) + "." + sky_pad(d.day) + "  " + w
}

fn sky_issue(){
    if report_current() != nil { return "独立日报" }
    let n = pf_briefs
    if phase != "done" && phase != "story" { n = n + 1 }
    if n < 1 { n = 1 }
    let t = "" + n
    if n < 10 { return "No.00" + t }
    if n < 100 { return "No.0" + t }
    "No." + t
}

fn sky_clock(ts){
    let d = local_time(ts + 28800)
    sky_pad(d.hour) + ":" + sky_pad(d.minute)
}

fn sky_status(){
    if report_focus != "compose" { return "留住这一期，也留住读到的位置" }
    if phase == "intent" { return "日光已到 · 今天，想从哪条线索开始？" }
    if phase == "asking" { return "主编先问一句，再定今天的方向" }
    if phase == "plan" { return "由你批准，再接通信源" }
    if phase == "fetching" { return "信源正在逐个返回，不补齐未取到的条数" }
    if phase == "judging" { return "三个视角，依次把判断摆上桌" }
    if phase == "refused" { return "信源还不够扎实，今天宁可留白" }
    if phase == "done" { return "今日出刊 · 每一条都可追溯" }
    "清晨不急，让信息慢慢亮起来"
}

fn sky_pct(){
    if report_focus != "compose" { return "本机存档" }
    if phase == "fetching" { return ("" + ok_sources.len()) + " 个来源已返回" }
    if phase == "judging" { return ("" + panel.len()) + " / " + ("" + roles.len()) + " 位编辑" }
    if phase == "done" { return ("" + picked.len()) + " 条已出刊" }
    ""
}

fn sky_title_size(){
    let k = (sky_h - 96.0) / 136.0
    if k < 0.0 { k = 0.0 }
    if k > 1.0 { k = 1.0 }
    20.0 + k * 22.0
}

// =====================================================================
// 片头 · 「晨光翻页」：旭日升起，光从太阳处揭开纸页，无星星
// ---------------------------------------------------------------------
// 晨雾纸色 → 日核升起 → 水线揭开；1.80 秒有限编舞，可轻点跳过。
// 这是一段品牌入场，不冒充取数进度，不联网，不包含星点、白闪或随机进度。
// =====================================================================
let cg_t0 = 0.0
let cg_p = 0.0
let cg_g = 0.0
let cg_c = 0.0
let cg_txt = 1.0
let cg_a = 0.0
let cg_ig_t = 0.0
let cg_tid = nil
let cg_done = false

fn cg_hy(){ 104.0 + sky_h * 0.80 }

fn cg_ease(x){
    if x < 0.5 { return 8.0 * x * x * x * x }
    let y = 2.0 - 2.0 * x
    1.0 - y * y * y * y / 2.0
}

fn cg_start(){
    if cg_done { return }
    if quiet_motion { cg_off() return }
    cg_t0 = time_now()
    // 先画片头首帧再走定时器，避免工作台先闪现一帧后才盖上片头。
    ui.cg_layer.render()
    if cg_tid == nil { cg_tid = start_interval(0.033, || cg_step()) }
}

fn cg_step(){
    if cg_done { return }
    let t = time_now() - cg_t0
    cg_p = clamp(t / 2.10, 0.0, 1.0)
    cg_a = clamp(t / 0.22, 0.0, 1.0)
    cg_g = 1.0 - pow(1.0 - clamp((t - 0.08) / 0.92, 0.0, 1.0), 3.0)
    cg_c = cg_ease(clamp((t - 0.90) / 1.14, 0.0, 1.0))
    cg_txt = 1.0 - clamp((t - 0.82) / 0.36, 0.0, 1.0)
    if t >= 2.10 { cg_off() return }
    ui.cg_layer.render()
}

fn cg_pct(){
    let n = floor(cg_p * 100.0)
    let t = "" + n
    if n < 10 { return "0" + t }
    t
}

fn cg_hint(){
    "海面接住晨光，纸页接住今天。"
}

fn cg_off(){
    if cg_done { return }
    cg_done = true
    if cg_tid != nil { stop_timer(cg_tid) }
    cg_tid = nil
    ui.cg.set_visible(false)
}

fn boot(){
    // 先移走纯色遮罩并设硬截止；恢复任何文件失败都不能把用户困在开场。
    ui.cg_veil.set_visible(false)
    start_timeout(3.0, || cg_off())
    try { load_last() } catch { heal_note("上期文件未能恢复，已进入安全工作台") }
    try { art_load() } catch { art_cache = [] }
    try { pf_load() } catch { sync_break() }
    try { arc_load() } catch { arc = [] }
    try { fc_load() } catch { fc_items = [] }
    try { ledger_load() } catch { sync_break() }
    try { trail_load() } catch { sync_break() }
    try { iv_load() } catch { sync_break() }
    try { report_load() } catch {
        reports = [] report_open = [] report_sessions = {} report_focus = "compose"
        heal_note("日报会话未能恢复，原文件保留；可继续新建日报")
    }
    // 解析器可能提前终止当前函数，因此原件备份放在恢复调用的外面。
    try { report_recover_file() } catch { report_storage_lock = true }
    sync_ui()
    sky_kick()

    cg_start()
}
fn tick(){ watch_tick() }
start_timeout(0.05, || boot())

// ---- 视觉体系「破晓 Daybreak」：奶油纸 + 青墨字 + 日出杏橙 + 晨海薄荷 ----
// 一个颜色只做一件事：金棕 = 元信息；杏橙 = 行动；青墨 = 正文。太阳保持高亮，文字保持对比。
let ink = #x243e37
let soft = #x4b655d
let secondary = #x61736b
let faint = #x65786f
let accent = #xba5e3b
let ground = #xf6f2e8
let paper = #xfffaf1
let surface2 = #xf0e8d8
let hair = #xddd6c7
let gold = #x9b5d29
let night = #xf3ecd9
let lav = #x3d7b78

// 原生按钮默认 hover/down 会 snap 到 1，4*x*(1-x) 的波纹因而整段为零。
// 为交互材质单独提供有时长的状态插值；空闲后不保留动画时钟。
let WaterBtn = ButtonFlat{
    animator.hover.on.from.all.duration: 0.28
    animator.hover.on.from.down.duration: 0.24
    animator.hover.on.apply.draw_bg.hover: 1.0
    animator.hover.down.from.all.duration: 0.32
    animator.hover.down.apply.draw_bg.down: 1.0
    animator.hover.off.from.all.duration: 0.22
}

// ---- 主题开关 · 选中=日冕金实心（深字），未选=发丝描边；两态各一个控件，靠可见性切换 ----
let ChipOn = WaterBtn{height: 36 padding: Inset{left: 14 right: 14} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {hover: instance(0.0) down: instance(0.0) pixel: fn(){
        let sz = self.rect_size
        let sdf = Sdf2d.viewport(self.pos * sz)
        sdf.box(1.0, 1.0, sz.x - 2.0, sz.y - 2.0, min(20.0, sz.y * 0.5 - 1.0))
        let d = length(self.pos * sz - sz * 0.5)
        let reach = max(sz.x, sz.y) * 0.75
        let h = self.hover
        let k = self.down
        let ha = 4.0 * h * (1.0 - h)
        let ka = 4.0 * k * (1.0 - k)
        let hr = exp(-pow((d - h * reach) / 8.0, 2.0)) * ha
        let kr = exp(-pow((d - k * reach) / 7.0, 2.0)) * ka
        var c = #xf7c571
        c = c.mix(#xffdda0, h * 0.55)
        c = c.mix(#x6eaa98, clamp(hr * 0.22 + kr * 0.32, 0.0, 1.0))
        c = c.mix(#xffffff, clamp(kr * 0.45, 0.0, 1.0))
        sdf.fill(c)
        sdf.stroke(#xe8b25b.mix(#x588b7f, h), 1.0)
        return sdf.result
    }}
    draw_text +: {color: #x294137 color_hover: #x294137 color_down: #x294137 text_style.font_size: 12}
}
let ChipOff = WaterBtn{height: 36 padding: Inset{left: 14 right: 14} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {hover: instance(0.0) down: instance(0.0) pixel: fn(){
        let sz = self.rect_size
