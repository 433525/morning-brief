// =====================================================================
// 决策台 · Jev / System One 式的「校准选择」
// ---------------------------------------------------------------------
// 2026 年 9 月，TypeSafe AI 放出 Jev：它不写文章，只把输入归进「预设输出集合」，
// 返回是/否概率、从给定选项里选一个、或按等级打分——结果带类型、带置信度，
// 程序可以直接拿去做分支。随后 OpenAI 上线 Decisions API、Databricks 出 ai_decide、
// Cloudflare 放开源 Clef 系列：行业开始分工，生成式模型写给人看，决策模型给代码用。
// 这个应用把这条分工搬进编辑部：主编（生成式）照旧写导语与入选理由，给人读；
// 决策台拿同一批候选再判一次，只回「选项 + 置信度」，给程序用。两边不一致的地方
// 记成「分歧」，写进留痕。
// 本机没有 System One 端点，所以这里走同一条 model.complete 通道，把 schema 收紧成
// 「预设集合 + 0-100」，并把「不要写理由」写进 task —— 不在没有端点时假装有端点，
// 只把决策模型那套约束老老实实照搬过来。将来有真正的决策端点，替换 vd_kick() 里
// 那一次 host.request 即可，其余不动。
// =====================================================================

// 预设输出集合：像 Jev 的 Choice 一样，答案只能落在这四个里，落不进去记 unknown。
let vd_tiers = ["first" "second" "rumor" "repost"]
let vd_shape = {type: "object" required: ["verdicts"] properties: {verdicts: {type: "array" items: {type: "object" required: ["i" "tier" "worth" "heat"] properties: {i: {type: "integer"} tier: {type: "string"} worth: {type: "integer"} heat: {type: "integer"}}}}}}

let vd_state = ""
let vd_note = ""
let vd_rows = []
let vd_agree = 0
let vd_unknown = 0
let vd_ms = 0
let vd_tokens = 0
let vd_t0 = 0

fn vd_reset(){
    vd_state = ""
    vd_note = ""
    vd_rows = []
    vd_agree = 0
    vd_unknown = 0
    vd_ms = 0
    vd_tokens = 0
}

// 一次调用、三个问题，全部是「有限选项」：档位（Choice）、够不够格（Noul）、热度（Score）。
fn vd_kick(){
    if picked.len() == 0 { return }
    vd_reset()
    vd_state = "asking"
    vd_note = "决策台正在对同一批候选做一次校准判断…"
    sync_ui()
    let list = ""
    let i = 0
    for r in picked {
        list = list + "" + i + ". [" + tier_label(r) + "] " + r.title + "\n"
        i = i + 1
    }
    vd_t0 = time_now()
    brief_request("model.complete", {
        task: "[编辑部宪法 judge/" + charter_v("judge") + "]\n你是决策台，不是写手。同一批候选，生成式主编已经写过理由，你只做三件事：给每条归一个信源档位、给一个「够不够格上晨报」的概率、给一个热度分。硬规矩：tier 只能取 first / second / rumor / repost 四个值之一，落不进任何一档就写 unknown；worth 是「这条够格上晨报」为真的概率，0 到 100 的整数；heat 是公众关注度，0 到 10 的整数。不要写任何解释、理由或句子。直接输出 JSON，第一个字符就是 {，不要围栏，不要思考过程。结构：verdicts 是数组，每项含 i（候选序号，整数）、tier（字符串）、worth（整数）、heat（整数）。"
        input: "候选（序号从 0 开始；每条前面的方括号是本报按域名判出的信源档位，仅供参考）：\n" + list
        schema: vd_shape
        class: "fast"
        allow_urls: false
    }, fn(r){
        if r.is_ok && r.data != nil && r.data.output != nil && r.data.output.verdicts != nil {
            vd_ms = (time_now() - vd_t0) * 1000
            vd_tokens = model_tokens(r.data)
            vd_put(r.data.output.verdicts)
            vd_state = "ok"
            vd_trail()
        } else {
            vd_state = "failed"
            vd_note = "决策台这次没有答复，本期的取舍仍然以上面那一版为准。"
        }
        sync_ui()
    })
}

// 把回答收进预设集合：落不进集合的档位一律记 unknown，别让自由文本混进结构化结果。
// 同时跟本报按域名判出的档位对一下，不一致就是一次「分歧」。
fn vd_put(list){
    vd_rows = []
    vd_agree = 0
    vd_unknown = 0
    for v in list {
        let idx = v.i
        if idx != nil {
            if idx >= 0 && idx < picked.len() {
                let r = picked[idx]
                let t = "" + v["tier"]
                let known = false
                for p in vd_tiers { if p == t { known = true } }
                if known == false { t = "unknown" vd_unknown = vd_unknown + 1 }
                let w = 0
                if v["worth"] != nil { w = v["worth"] }
                let h = 0
                if v["heat"] != nil { h = v["heat"] }
                let same = false
                if t == tier_of(r) { same = true vd_agree = vd_agree + 1 }
                vd_rows.push({row: r tier: t worth: w heat: h same: same})
            }
        }
    }
}

fn vd_trail(){
    if trail.len() == 0 { return }
    let box = []
    for v in vd_rows {
        box.push({title: v.row.title tier: v.tier worth: v.worth heat: v.heat same: v.same})
    }
    trail["decision"] = {agree: vd_agree total: vd_rows.len() unknown: vd_unknown ms: vd_ms tokens: vd_tokens rows: box}
    trail_save()
}

fn vd_tier_name(t){
    if t == "first" { return "一手" }
    if t == "second" { return "二手" }
    if t == "rumor" { return "传闻·未证实" }
    if t == "repost" { return "转载" }
    if t == "unknown" { return "超出预设集合" }
    t
}

fn vd_head_line(){
    if vd_state == "asking" { return vd_note }
    if vd_state == "failed" { return vd_note }
    if vd_rows.len() == 0 { return "决策台没有给出结论。" }
    let line = "与本报判级一致 " + vd_agree + "/" + vd_rows.len() + " · 用时 " + seconds_text(vd_ms) + " · " + vd_tokens + " tokens"
    if vd_unknown > 0 { line = line + " · 有 " + vd_unknown + " 条落不进预设集合" }
    line
}

fn vd_row_text(k){
    if k >= vd_rows.len() { return "" }
    let v = vd_rows[k]
    let tag = "分歧"
    if v.same { tag = "一致" }
    let call = "不值得上"
    if v.worth >= 50 { call = "够格上" }
    "" + (k + 1) + ". 信源 " + vd_tier_name(v.tier) + " · 与本报" + tag + "\n    " + call + " " + v.worth + "% · 热度 " + v.heat + "/10 · " + art_cut("" + v.row.title, 26)
}

fn vd_open(k){
    if k >= vd_rows.len() { return }
    open_story(vd_rows[k].row)
}

// ---- 语音音色优选：宿主报上来的音色里，挑最像人的那一个 ----
// 各家 shell 都会把可用音色连 id、name、language 一起报上来。Windows 自带的
// SAPI 音色偏机械，新系统的 Natural / Neural 音色自然得多；edge-tts 那类云端
// 神经音色（XiaoxiaoNeural / YunxiNeural / YunyangNeural…）是同一族的命名。
// 这里只做「挑一个」，不做合成；挑不到就返回空串，宿主用它的默认音色，行为不变。
let vc_voice = ""

fn vc_has(s, sub){
    if s.search(sub) >= 0 { return true }
    false
}

fn vc_pick_voice(vs){
    let best = ""
    let best_rank = 99
    for v in vs {
        let lang = ""
        if v["language"] != nil { lang = "" + v["language"] }
        if vc_has(lang, "zh") {
            let vid = ""
            let all = ""
            if v["id"] != nil { vid = "" + v["id"] all = vid }
            if v["name"] != nil { all = all + " " + ("" + v["name"]) }
            let rk = 8
            if vc_has(all, "Natural") { rk = 0 }
            else if vc_has(all, "Neural") { rk = 1 }
            else if vc_has(all, "Xiaoxiao") { rk = 2 }
            else if vc_has(all, "Yunxi") { rk = 3 }
            else if vc_has(all, "Yunyang") { rk = 4 }
            else if vc_has(all, "Huihui") { rk = 5 }
            else if vc_has(all, "Yaoyao") { rk = 6 }
            if vid != "" && rk < best_rank { best_rank = rk best = vid }
        }
    }
    if best_rank >= 9 { return "" }
    best
}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay
        SolidView{width: Fill height: Fill draw_bg.color: ground}
        water := View{width: Fill height: Fill
            on_render: || {
                View{width: Fill height: Fill show_bg: true new_batch: true
                    draw_bg +: {
                        rx: instance(0.5) ry: instance(0.6) wt: instance(0.0) rp: instance(0.0)
                        pixel: fn(){
                            let sz = self.rect_size
                            let p = self.pos * sz
                            var c = #xf8f4e9.mix(#xf1eee1, self.pos.y)
                            let glow = exp(-length(self.pos - vec2(0.82, 0.08)) * 3.6)
                            c = c.mix(#xffe8bf, glow * 0.28)
                            let d = length(p - vec2(self.rx * sz.x, self.ry * sz.y))
                            let radius = self.wt * 430.0
                            let r1 = exp(-pow((d - radius) / 13.0, 2.0))
                            let r2 = exp(-pow((d - max(0.0, radius - 35.0)) / 9.0, 2.0))
                            c = c.mix(#x76ac9d, clamp((r1 * 0.10 + r2 * 0.05) * self.rp, 0.0, 1.0))
                            return vec4(c.x, c.y, c.z, 1.0)
                        }
                    }
                    draw_bg.rx: water_at draw_bg.ry: water_y draw_bg.wt: water_t draw_bg.rp: water_pulse
                }
            }
        }
        View{width: Fill height: Fill flow: Down
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 4 padding: Inset{left: 10 right: 10 top: 6 bottom: 4}
                report_tabs := ScrollXView{width: Fill height: 46 flow: Right
                    on_render: || {
                        View{width: Fit height: 44 flow: Right spacing: 4
                            if report_focus == "compose" {
                                IssueActive{text: compose_text() on_click: || report_activate("compose")}
                            } else {
                                IssueInactive{text: compose_text() on_click: || report_activate("compose")}
                            }
                            for id in report_open {
                                let did = id
                                View{width: Fit height: 44 flow: Right spacing: 0
                                    if report_focus == did {
                                        IssueActive{text: report_label(did) on_click: || report_activate(did)}
                                    } else {
                                        IssueInactive{text: report_label(did) on_click: || report_activate(did)}
                                    }
                                    IssueClose{text: "×" on_click: || report_close(did)}
                                }
                            }
                        }
                    }
                }
                IssueTool{text: "往期" on_click: || report_shelf_toggle()}
                IssueTool{text: "＋" on_click: || report_new()}
            }
            View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 3 padding: Inset{left: 10 right: 10}
                IssueTool{width: 44 height: 36 text: "‹ 上期" on_click: || report_shift(-1)}
                IssueTool{width: 44 height: 36 text: "下期 ›" on_click: || report_shift(1)}
                Label{width: Fill text: "晨间阅读台 · 日报可横向滑动" draw_text.color: secondary draw_text.text_style.font_size: 9}
                motion_toggle := IssueTool{width: 52 height: 36 text: "轻动效" on_click: || quiet_toggle()}
            }
            report_shelf := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 8
                margin: Inset{left: 10 right: 10 bottom: 8} padding: Inset{left: 12 right: 12 top: 10 bottom: 10}
                show_bg: true new_batch: true draw_bg.color: paper draw_bg.border_radius: 16.0
                draw_bg.border_size: 1.0 draw_bg.border_color: hair
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    Label{width: Fill text: "晨间档案" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    report_reopen := BarBtn{visible: false text: "重开刚关闭" on_click: || report_reopen_last()}
                }
                report_query_in := TextInput{width: Fill height: 40 empty_text: "找日期，或找这一期的主题"
                    on_change: |text| report_search(text)
                    draw_bg +: {color: ground color_hover: surface2 color_focus: surface2 color_empty: ground border_color: hair border_color_focus: gold border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: faint}
                }
                report_catalog := ScrollYView{width: Fill height: 172 flow: Down
                    on_render: || {
                        View{width: Fill height: Fit flow: Down spacing: 6
                            let shown = 0
                            for document in reports {
                                // 直接用当前文档的数据，不在 reports 渲染循环里再次 report_find/reports。
                                let did = s_of(document, "id")
                                let stamp = report_stamp(num_of(document, "ts"))
                                let headline = s_of(document, "cover_head")
                                let hay = stamp + " " + headline + " " + s_of(document, "intro")
                                if report_query == "" || hay.search(report_query) >= 0 {
                                    shown = shown + 1
                                    View{width: Fill height: Fit flow: Down spacing: 1
                                        GhostBtn{width: Fill height: 44 text: stamp + "  ·  " + art_cut(headline, 20) on_click: || report_open_issue(did)}
                                        Label{width: Fill text: ("" + list_of(document, "rows").len()) + " 条线索 · 关闭页签不会删除这一期" draw_text.color: secondary draw_text.text_style.font_size: 10}
                                    }
                                }
                            }
                            if shown == 0 {
                                Label{width: Fill text: "这里还没有匹配的日报。出刊后自动保存，不伪造往期。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                            }
                        }
                    }
                }
            }
            // ---- 浏览器式栏目标签 · 五个格子等分，坐在一条水线上 ----
            //      点哪一格哪一格亮；正在翻开的那一格，金色光点会顺着水线滑过去。
            tab_rail := View{width: Fill height: Fit flow: Down show_bg: true new_batch: true
                draw_bg +: {pixel: fn(){
                    let sz = self.rect_size
                    let sdf = Sdf2d.viewport(self.pos * sz)
                    sdf.box(0.0, 0.0, sz.x, sz.y, 0.0)
                    sdf.fill(#xfaf4e6)
                    sdf.box(0.0, sz.y - 1.0, sz.x, 1.0, 0.0)
                    sdf.fill(#xded7c5)
                    return sdf.result
                }}
                View{width: Fill height: Fit flow: Right spacing: 3 padding: Inset{left: 10 right: 10 top: 6 bottom: 0}
                    tab_front_on := TabActive{text: "头版" on_click: || set_tab("front")}
                    tab_front_off := TabInactive{text: "头版" on_click: || set_tab("front")}
                    tab_pool_on := TabActive{text: "情报池" on_click: || set_tab("pool")}
                    tab_pool_off := TabInactive{text: "情报池" on_click: || set_tab("pool")}
                    tab_review_on := TabActive{text: "复盘" on_click: || set_tab("review")}
                    tab_review_off := TabInactive{text: "复盘" on_click: || set_tab("review")}
                    tab_stand_on := TabActive{text: "立场" on_click: || set_tab("stand")}
                    tab_stand_off := TabInactive{text: "立场" on_click: || set_tab("stand")}
                    tab_story_on := TabActive{text: "读稿" on_click: || set_tab("story")}
                    tab_story_off := TabInactive{text: "读稿" on_click: || set_tab("story")}
                }
            }
            // ---- 地平线带 · 所有阶段共用；太阳的高度 = 今天这份报做到哪了 ----
            nav_waterline := View{width: Fill height: 3
                on_render: || {
                    View{width: Fill height: 3 show_bg: true new_batch: true
                        draw_bg +: {
                            marker: instance(0.0)
                            pixel: fn(){
                                let sz = self.rect_size
                                let sdf = Sdf2d.viewport(self.pos * sz)
                                let x = (self.marker + 0.5) * sz.x * 0.2
                                sdf.box(0.0, 1.0, sz.x, 1.0, 0.0)
                                sdf.fill(#xe0dac9)
                                sdf.box(x - 14.0, 0.0, 28.0, 2.5, 1.2)
                                sdf.fill(#xc8944d)
                                return sdf.result
                            }
                        }
                        draw_bg.marker: tab_from + (tab_to - tab_from) * (1.0 - pow(1.0 - tab_p, 3.0))
                    }
                }
            }
            sky := View{width: Fill height: Fit flow: Down
                on_render: || {
                    View{width: Fill height: sky_h flow: Overlay
                        View{width: Fill height: Fill show_bg: true new_batch: true
                            draw_bg +: {
                                sr: instance(0.0)
                                pixel: fn(){
                                    let sz = self.rect_size
                                    let p = self.pos * sz
                                    let r = self.sr
                                    let hy = sz.y * 0.80
                                    let sx = sz.x * 0.82
                                    let rad = min(45.0, sz.x * 0.11)
                                    let sy = hy + rad * 0.75 - r * rad * 2.20
                                    let above = 1.0 - smoothstep(hy - 1.0, hy + 1.0, p.y)
                                    let band = clamp(p.y / max(1.0, hy), 0.0, 1.0)
                                    var col = #xe8eddb.mix(#xffce91, pow(band, 1.55))
                                    let warm = exp(-length((p - vec2(sx, hy)) / vec2(240.0, 100.0)))
                                    col = col.mix(#xffbb75, warm * 0.32 * above)
                                    let dist = length(p - vec2(sx, sy))
                                    let halo = exp(-max(0.0, dist - rad) / 38.0)
                                    col = col.mix(#xffe3b0, halo * above * 0.22)
                                    let sun = 1.0 - smoothstep(rad - 0.7, rad + 0.7, dist)
                                    col = col.mix(#xffffdf, sun * above)
                                    let below = 1.0 - above
                                    let dep = clamp((p.y - hy) / max(1.0, sz.y - hy), 0.0, 1.0)
                                    let sea = #x85b3a0.mix(#xdeead2, dep)
                                    col = col.mix(sea, below)
                                    let ripple = 0.5 + 0.5 * sin((p.y - hy) * 0.62 + sin(p.x * 0.035) * 1.7 - r * 4.0)
                                    let reflection = exp(-abs(p.x - sx) / (18.0 + dep * 44.0)) * (1.0 - dep * 0.75) * ripple * below
                                    col = col.mix(#xffde8e, reflection * 0.62)
                                    let horizon = exp(-abs(p.y - hy) / 2.0)
                                    col = col.mix(#xffedb7, horizon * 0.68)
                                    let grain = fract(sin(dot(floor(p), vec2(12.9898, 78.233))) * 43758.54)
                                    col = col.mix(#xf0e5ce, grain * 0.025)
                                    col = col.mix(#xf6f2e8, smoothstep(sz.y - 25.0, sz.y, p.y))
                                    return vec4(col.x, col.y, col.z, 1.0)
                                }
                            }
                            draw_bg.sr: sky_r
                        }
                        View{width: Fill height: Fill flow: Down padding: Inset{left: 22 right: 22 top: 20 bottom: 0}
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.0} spacing: 10
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{text: "晨报" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: sky_title_size() + 3}}
                                }
                                View{width: Fit height: Fit flow: Down spacing: 3 align: Align{x: 1.0}
                                    Label{text: sky_issue() draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 11}}
                                    if sky_h > 120.0 {
                                        Label{text: sky_date() draw_text.color: secondary draw_text.text_style: theme.font_code{font_size: 10}}
                                    }
                                }
                            }
                            if sky_h > 180.0 {
                                Label{width: Fill margin: Inset{top: 6} text: "让信息有来处，让清晨有光。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                            }
                            // 报纸式双细线：刊名与内容之间的一道「版线」
                            View{width: Fill height: Fit flow: Down spacing: 2 margin: Inset{top: 8}
                                SolidView{width: Fill height: 2 draw_bg.color: gold}
                                SolidView{width: Fill height: 1 draw_bg.color: hair}
                            }
                            View{width: Fill height: Fill}
                            if sky_h > 124.0 {
                                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{bottom: sky_h * 0.2 + 9.0}
                                    View{width: 8 height: 8 show_bg: true new_batch: true
                                        draw_bg +: {pixel: fn(){
                                            let sz = self.rect_size
                                            let d = length(self.pos * sz - sz * 0.5)
                                            let k = 0.55 + 0.45 * sin(floor(0.0 * 2.0) * 3.2)
                                            let a = (1.0 - smoothstep(2.4, 3.4, d)) + (1.0 - smoothstep(0.0, 4.0, d)) * 0.35 * k
                                            let c = #x9b5d29
                                            return vec4(c.x * a, c.y * a, c.z * a, a)
                                        }}
                                    }
                                    Label{width: Fill text: sky_status() draw_text.color: soft draw_text.text_style.font_size: 12}
                                    Label{text: sky_pct() draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 10}}
                                }
                            }
                        }
                    }
                }
            }
            View{width: Fill height: Fill flow: Overlay
                browse := ScrollYView{width: Fill height: Fill flow: Down spacing: 12 padding: Inset{left: 20 right: 20 top: 10 bottom: 96}
                    View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{bottom: 4}
                        home_title := Label{width: Fill text: "今天想读什么？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
                        intent_line := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                    }
                    setup_box := View{width: Fill height: Fit flow: Down spacing: 12
                        ask_in := TextInput{width: Fill height: 50 empty_text: "直接说也行：我想看芯片和 AI 的大新闻"
                            on_change: |text| set_ask(text)
                            draw_bg +: {color: paper color_hover: #xf0eadc color_focus: #xf0eadc color_empty: paper
                                border_color: hair border_color_hover: #x3a4288 border_color_focus: gold border_color_empty: hair
                                border_radius: 16.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: faint color_empty_hover: secondary}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 10}
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                                SecLabel{text: "话题"}
                            }
                            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                                chip_ai_on := ChipOn{text: "AI" on_click: || toggle_topic("ai")}
                                chip_ai_off := ChipOff{text: "AI" on_click: || toggle_topic("ai")}
                                chip_oss_on := ChipOn{text: "开源" on_click: || toggle_topic("oss")}
                                chip_oss_off := ChipOff{text: "开源" on_click: || toggle_topic("oss")}
                                chip_sec_on := ChipOn{text: "安全" on_click: || toggle_topic("sec")}
                                chip_sec_off := ChipOff{text: "安全" on_click: || toggle_topic("sec")}
                                chip_chip_on := ChipOn{text: "芯片" on_click: || toggle_topic("chip")}
                                chip_chip_off := ChipOff{text: "芯片" on_click: || toggle_topic("chip")}
                                chip_life_on := ChipOn{text: "生活" on_click: || toggle_topic("life")}
                                chip_life_off := ChipOff{text: "生活" on_click: || toggle_topic("life")}
                                chip_biz_on := ChipOn{text: "财经" on_click: || toggle_topic("biz")}
                                chip_biz_off := ChipOff{text: "财经" on_click: || toggle_topic("biz")}
                                chip_sci_on := ChipOn{text: "科学" on_click: || toggle_topic("sci")}
                                chip_sci_off := ChipOff{text: "科学" on_click: || toggle_topic("sci")}
                            }
                        }
                        View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 10}
                            SecLabel{text: "信源 · 海外"}
                            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                                pk_hn_on := ChipOn{text: "HN" on_click: || toggle_plat("hn")}
                                pk_hn_off := ChipOff{text: "HN" on_click: || toggle_plat("hn")}
                                pk_techmeme_on := ChipOn{text: "TechMeme" on_click: || toggle_plat("techmeme")}
                                pk_techmeme_off := ChipOff{text: "TechMeme" on_click: || toggle_plat("techmeme")}
                                pk_github_on := ChipOn{text: "GitHub" on_click: || toggle_plat("github")}
                                pk_github_off := ChipOff{text: "GitHub" on_click: || toggle_plat("github")}
                                pk_arxiv_on := ChipOn{text: "arXiv" on_click: || toggle_plat("arxiv")}
                                pk_arxiv_off := ChipOff{text: "arXiv" on_click: || toggle_plat("arxiv")}
                                pk_youtube_on := ChipOn{text: "油管" on_click: || toggle_plat("youtube")}
                                pk_youtube_off := ChipOff{text: "油管" on_click: || toggle_plat("youtube")}
                            }
                            SecLabel{text: "信源 · 国内"}
                            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                                pk_sspai_on := ChipOn{text: "少数派" on_click: || toggle_plat("sspai")}
                                pk_sspai_off := ChipOff{text: "少数派" on_click: || toggle_plat("sspai")}
                                pk_infoq_on := ChipOn{text: "InfoQ" on_click: || toggle_plat("infoq")}
                                pk_infoq_off := ChipOff{text: "InfoQ" on_click: || toggle_plat("infoq")}
                                pk_ithome_on := ChipOn{text: "IT之家" on_click: || toggle_plat("ithome")}
                                pk_ithome_off := ChipOff{text: "IT之家" on_click: || toggle_plat("ithome")}
                                pk_bili_on := ChipOn{text: "B站" on_click: || toggle_plat("bili")}
                                pk_bili_off := ChipOff{text: "B站" on_click: || toggle_plat("bili")}
                                pk_douyin_on := ChipOn{text: "抖音" on_click: || toggle_plat("douyin")}
                                pk_douyin_off := ChipOff{text: "抖音" on_click: || toggle_plat("douyin")}
                            }
                        }
                        RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                            padding: Inset{top: 10 bottom: 10 left: 16 right: 10} margin: Inset{top: 8}
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 16.0
                            draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            View{width: Fill height: Fit flow: Down spacing: 2
                                Label{text: "本期条数" draw_text.color: soft draw_text.text_style.font_size: 13}
                                Label{text: "编辑部会按这个上限取舍" draw_text.color: faint draw_text.text_style.font_size: 10}
                            }
                            NumBtn{text: "−" on_click: || bump(-1)}
                            View{width: 40 height: Fit align: Align{x: 0.5}
                                limit_label := Label{text: "10" draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 20}}
                            }
                            NumBtn{text: "+" on_click: || bump(1)}
                        }
                        gen_pane := View{visible: true width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 8}
                            HeroBtn{text: "生成今日晨报" on_click: || aq_start()}
                            Label{width: Fill align: Align{x: 0.5} text: "先出一份取数计划，你批准之后才会联网" draw_text.color: faint draw_text.text_style.font_size: 11}
                        }
                    }
                    // ---- 出报前的一问：主编先开口，读者答 A / B，也可以让他别问了 ----
                    aq_pane := Panel{visible: false
                        Label{width: Fill text: "出报前，主编想问一句" draw_text.color: accent draw_text.text_style.font_size: 12}
                        aq_q := Label{width: Fill text: "" max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                        View{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 4}
                            aq_btn_a := GhostBtn{width: Fill text: "A" on_click: || aq_choose("a")}
                            aq_btn_b := GhostBtn{width: Fill text: "B" on_click: || aq_choose("b")}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                            aq_note := Label{width: Fill text: "" draw_text.color: faint draw_text.text_style.font_size: 10}
                            BarBtn{text: "你定，不用问" on_click: || aq_choose("skip")}
                        }
                    }
                    plan_pane := Panel{visible: false
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                            Label{width: Fill text: "取数计划 · 等你批准" draw_text.color: accent draw_text.text_style.font_size: 12}
                            Label{text: "未联网" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                        }
                        plan_ask := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        plan_ai := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        RoundedView{width: Fill height: Fit flow: Down spacing: 6
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            new_batch: true show_bg: true draw_bg.color: surface2 draw_bg.border_radius: 12.0
                            plan_topics := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 13}
                            plan_limit := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 13}
                            plan_hosts := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: theme.font_code{font_size: 10}}
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{top: 4}
                            PrimaryBtn{width: Fill text: "批准并取数" on_click: || approve()}
                            GhostBtn{text: "暂不" on_click: || deny()}
                        }
                    }
                    judge_pane := Panel{visible: false spacing: 8
                        judge_line := Label{width: Fill text: "" draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 15}}
                        Label{width: Fill text: "三位编辑背靠背独立阅读，互相看不到对方的选择；随后由主编终审取舍。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        RoundedView{width: Fill height: Fit flow: Down spacing: 6
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            new_batch: true show_bg: true draw_bg.color: surface2 draw_bg.border_radius: 12.0
                            panel_head := Label{width: Fill text: "" draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 10}}
                            p1 := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                            p2 := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                            p3 := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                        }
                    }
                    deny_pane := Panel{visible: false
                        Label{width: Fill text: "已取消，没有发出任何网络请求" draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 15}}
                        Label{width: Fill text: "你的授权是取数的前提；拒绝后不会读取任何来源。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                            GhostBtn{text: "重新开始" on_click: || restart()}
                        }
                    }
                    hint_line := Label{width: Fill align: Align{x: 0.5} margin: Inset{top: 14} text: "这份报会记住你读过什么，越读越懂你；右下角的主编能说话，也能查本报档案。" draw_text.color: faint draw_text.text_style.font_size: 10}
                }
                // ---- 主编拒刊页：信源太薄时不出报。这不是失败，是拒绝。 ----
                // ---- 情报池：今天从哪些地方、取了多少条、筛掉了什么 ----
                pool_pane := View{visible: false width: Fill height: Fill flow: Down
                    ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 20 right: 20 top: 16 bottom: 96}
                        View{width: Fill height: Fit flow: Down spacing: 9
                            Label{width: Fill text: "多源情报池" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                            SecLine{}
                            Label{width: Fill text: "今天从哪些信源、按什么规则取了多少条 —— 以及哪些进了池子还没上版。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                        pool_head := Label{width: Fill text: "" draw_text.color: gold draw_text.text_style.font_size: 12}
                        Glass{
                            Label{width: Fill text: "候选 · 上池" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            pool_rows := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                        Glass{
                            Label{width: Fill text: "取数与兜底" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            pool_panel := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                        }
                        Glass{
                            Label{width: Fill text: "工作记录" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            pool_work := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                            GhostBtn{text: "回到头版" on_click: || set_tab("front")}
                            BarBtn{text: "重新出报 ›" on_click: || go_prep()}
                        }
                    }
                }
                // ---- 编辑部复盘：这一期是怎么被判进来的 ----
                review_pane := View{visible: false width: Fill height: Fill flow: Down
                    ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 20 right: 20 top: 16 bottom: 96}
                        View{width: Fill height: Fit flow: Down spacing: 9
                            Label{width: Fill text: "编辑部复盘" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                            SecLine{}
                            Label{width: Fill text: "三位编辑各自推荐了什么、留下了什么、事实核查记了几笔 —— 出报留痕里都有。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                        review_head := Label{width: Fill text: "" draw_text.color: gold draw_text.text_style.font_size: 12}
                        Glass{
                            Label{width: Fill text: "时间与预算" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            review_time := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                        Glass{
                            Label{width: Fill text: "事实核查 · 编辑部内部对照" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            review_fc := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                            GhostBtn{text: "回到头版" on_click: || set_tab("front")}
                            BarBtn{text: "看情报池 ›" on_click: || set_tab("pool")}
                        }
                    }
                }
                // ---- 立场与更正：不改已发的稿，但每一笔更正都记账 ----
                stand_pane := View{visible: false width: Fill height: Fill flow: Down
                    ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 20 right: 20 top: 16 bottom: 96}
                        View{width: Fill height: Fit flow: Down spacing: 9
                            Label{width: Fill text: "立场与更正" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                            SecLine{}
                            Label{width: Fill text: "我们只做两件事：说清楚自己站在哪，以及错了就记一笔。" draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                        stand_head := Label{width: Fill text: "" draw_text.color: gold draw_text.text_style.font_size: 12}
                        Glass{
                            Label{width: Fill text: "更正台账" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            stand_ledger := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                        Glass{
                            Label{width: Fill text: "本报的立场" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                            stand_creed := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style.font_size: 12}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                            GhostBtn{text: "回到头版" on_click: || set_tab("front")}
                            BarBtn{text: "看复盘 ›" on_click: || set_tab("review")}
                        }
                    }
                }
                refuse_pane := View{visible: false width: Fill height: Fill flow: Down
                    ScrollYView{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 20 right: 20 top: 12 bottom: 200}
                        Label{width: Fill text: "今天这些消息我没有把握，不想拿一个二手转述来充今天的晨报。" max_lines: 4 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                        Panel{spacing: 6
                            Label{width: Fill text: "为什么不出" draw_text.color: accent draw_text.text_style.font_size: 12}
                            refuse_why_l := Label{width: Fill text: "" max_lines: 8 draw_text.color: soft draw_text.text_style.font_size: 13}
                            refuse_tier := Label{width: Fill text: "" max_lines: 3 draw_text.color: secondary draw_text.text_style: theme.font_code{font_size: 10}}
                        }
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                            PrimaryBtn{width: Fill text: "仍要出报" on_click: || refuse_go()}
                            GhostBtn{text: "重新开始" on_click: || restart()}
                        }
                        Label{width: Fill text: "拒刊是主编的判断，不是对你的束缚 —— 决定权在你手里，你说了出，我就出。" max_lines: 3 draw_text.color: faint draw_text.text_style.font_size: 11}
                    }
                }
                run_pane := View{visible: false width: Fill height: Fill flow: Down
                  run_scroll := ScrollYView{width: Fill height: Fill flow: Down
                    View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 20 right: 20 top: 8 bottom: 12}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                            status_line := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                            st_gen := Label{text: "" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 9}}
                        }
                        fail_line := Label{visible: false width: Fill text: "" draw_text.color: accent draw_text.text_style.font_size: 11}
                        ai_sum := Label{visible: false width: Fill text: "" draw_text.color: lav draw_text.text_style.font_size: 11}
                        ai_intro := Label{visible: false width: Fill text: "" max_lines: 2 draw_text.color: soft draw_text.text_style: theme.font_italic{font_size: 13}}
                        ai_note := Label{visible: false width: Fill text: "" draw_text.color: faint draw_text.text_style.font_size: 10}
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 12.0
                            draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 9 bottom: 9 left: 12 right: 12}
                            pipe_line := Label{width: Fill text: "" draw_text.color: soft draw_text.text_style: theme.font_code{font_size: 9}}
                            st_src := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
                            work_line := Label{visible: false width: Fill text: "" draw_text.color: gold draw_text.text_style.font_size: 11}
                            tier_line := Label{visible: false width: Fill text: "" draw_text.color: faint draw_text.text_style.font_size: 10}
                        }
                        stale_line := Label{visible: false width: Fill text: "" draw_text.color: gold draw_text.text_style.font_size: 11}
                    }
                    list := View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{left: 16 right: 16 bottom: 6}
                        on_render: || {
                            if cover_on {
                                View{width: Fill height: 196 flow: Overlay
                                    new_batch: true
                                    Image{width: Fill height: Fill fit: ImageFit.CropToFill draw_bg.color: #xf7efdd draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair src: http_resource(cover_url)}
                                    SolidView{width: Fill height: Fill draw_bg.color: #x17392dcc draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair}
                                    View{width: Fill height: Fill flow: Down spacing: 6 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                                        View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                            Label{width: Fill text: "晨报卡 · AI EDITION" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 10}}
                                            Label{text: cover_line() draw_text.color: #xa9badb draw_text.text_style.font_size: 9}
                                        }
                                        View{width: Fill height: Fill}
                                        Label{width: Fill text: cover_head max_lines: 3 draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 21}}
                                        View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0}
                                            DarkBtn{text: "换一张头版" on_click: || cover_retry()}
                                        }
                                    }
                                }
                            } else if cover_state == "asking" || cover_state == "drawing" || cover_state == "failed" {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 4
                                    new_batch: true draw_bg.color: #xf6ecd8 draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                                    Label{width: Fill text: "今日头版 · 视觉主编" draw_text.color: #xffe2b8 draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: cover_note max_lines: 3 draw_text.color: secondary draw_text.text_style.font_size: 11}
                                }
                            }
                            // ---- 更正 · 报错了就写在最前面 ----
                            if fix_count() > 0 {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: #xf8e5d8 draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "更正 · 上一期有一处说法要改" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: fix_line(0) max_lines: 4 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{visible: fix_count() > 1 width: Fill text: fix_line(1) max_lines: 4 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{visible: fix_count() > 2 width: Fill text: fix_line(2) max_lines: 4 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{width: Fill text: "本报自己记着这笔。截至今天累计更正 " + ("" + fix_total) + " 条。" draw_text.color: #x65786f draw_text.text_style.font_size: 10}
                                }
                            }
                            // ---- 口径不一致 · 两个说法都在，我不替你选 ----
                            if clash_count() > 0 {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: #xf4efdf draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "本报注意到口径不一致" draw_text.color: #xa4642e draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: clash_line(0) max_lines: 5 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{visible: clash_count() > 1 width: Fill text: clash_line(1) max_lines: 5 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{width: Fill text: "两个数字都在，我不替你选。" draw_text.color: #x65786f draw_text.text_style.font_size: 10}
                                }
                            }
                            // ---- 主编押下的三条预测（下一期自己回来对账） ----
                            if fc_items.len() > 0 {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: #xf4efdf draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "主编押下的三条 · 下一期自己回来对账" draw_text.color: #xa4642e draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: fc_line(0) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{width: Fill text: fc_line(1) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{width: Fill text: fc_line(2) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{width: Fill text: fc_review_line() draw_text.color: #x65786f draw_text.text_style.font_size: 10}
                                }
                            } else if fc_state == "asking" || fc_state == "checking" {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 4
                                    new_batch: true show_bg: true draw_bg.color: #xf4efdf draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                                    Label{width: Fill text: "主编的三个预测" draw_text.color: #xa4642e draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: fc_note max_lines: 3 draw_text.color: #x61736b draw_text.text_style.font_size: 11}
                                }
                            }
                            // ---- 上一期押下的、已经对完账的记录 ----
                            if fc_hist_text() != "" {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 3
                                    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: fc_hist_text() max_lines: 10 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                }
                            }
                            // ---- 线索进展 · 同一条线索，本报上次听到时是什么成色 ----
                            if th_count() > 0 {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: th_line() draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: th_text(0) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{visible: th_count() > 1 width: Fill text: th_text(1) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                    Label{visible: th_count() > 2 width: Fill text: th_text(2) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                                }
                            }
                            // ---- 破晓时间线 · 每条新闻是弧上一枚光点，越早越贴近地平线 ----
                            let arc_rows = show_rows()
                            if arc_rows.len() > 0 {
                                View{width: Fill height: 176 flow: Overlay
                                    View{width: Fill height: Fill show_bg: true new_batch: true
                                        draw_bg +: {
                                            pixel: fn(){
                                                let sz = self.rect_size
                                                let px = self.pos.x
                                                let py = self.pos.y
                                                var c = #x0d1234
                                                let h = 4.0 * px * (1.0 - px)
                                                let ay = 0.86 - 0.70 * h
                                                let d = abs(py - ay)
                                                c = c.mix(#xd1c9b6, clamp(1.0 - d * 14.0, 0.0, 1.0) * 0.8)
                                                let hg = exp(-abs(py - 0.86) * 6.0) * exp(-px * 3.0)
                                                c = c.mix(#x9b5d29, clamp(hg * 0.5, 0.0, 1.0))
                                                return vec4(c.x, c.y, c.z, 1.0)
                                            }
                                        }
                                    }
                                    for i r in arc_rows {
                                        let n = 0.0 + arc_rows.len()
                                        let u = (0.0 + i + 0.5) / n
                                        let hh = 4.0 * u * (1.0 - u)
                                        GestureView{width: Fit height: Fit align: Align{x: u y: 0.86 - 0.70 * hh} on_tap: |x, y| open_story(r)
                                            RoundedView{width: 30 height: 30 flow: Overlay draw_bg.color: #x9b5d29 draw_bg.border_radius: 15.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xffe6bd
                                                Label{align: Align{x: 0.5 y: 0.5} text: rank_text(i) draw_text.color: #x243e37 draw_text.text_style: theme.font_bold{font_size: 12}}
                                            }
                                        }
                                    }
                                    Label{width: Fill align: Align{x: 0.5 y: 0.97} text: "破晓时间线 · 点一枚光点，读那一条" draw_text.color: #x65786f draw_text.text_style.font_size: 10}
                                }
                            }
                            let rows = show_rows()
                            if rows.len() == 0 {
                                View{width: Fill height: 120 align: Align{x: 0.5 y: 0.5}
                                    Label{text: empty_line() draw_text.color: secondary draw_text.text_style.font_size: 12}
                                }
                            }
                            else for i r in rows {
                                GestureView{width: Fill height: Fit on_tap: |x, y| open_story(r)
                                    let thumb = row_img(r)
                                    if thumb != "" {
                                        RowCardImg{col.rm.text: rank_text(i) + " · " + row_meta(r) col.rt.text: r.title
                                            col.rsu.text: row_sum(r) col.rsu.visible: row_sum(r) != ""
                                            col.rw.text: reason_of(r.id) col.rw.visible: reason_of(r.id) != ""
                                            col.rp.text: panel_mark(r.id) col.rp.visible: panel_mark(r.id) != ""
                                            rth.src: http_resource(thumb)}
                                    } else {
                                        RowCard{rm.text: rank_text(i) + " · " + row_meta(r) rt.text: r.title
                                            rsu.text: row_sum(r) rsu.visible: row_sum(r) != ""
                                            rw.text: reason_of(r.id) rw.visible: reason_of(r.id) != ""
                                            rp.text: panel_mark(r.id) rp.visible: panel_mark(r.id) != ""}
                                    }
                                }
                            }
                            // ---- 回放出报过程 · 这一期是怎么做出来的 ----
                            if phase == "done" && replay_text() != "" {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "回放 · 这一期是怎么做出来的" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: replay_pool_line() max_lines: 2 draw_text.color: #x61736b draw_text.text_style.font_size: 11}
                                    Label{width: Fill text: replay_panel_line() max_lines: 10 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                    Label{width: Fill text: replay_judge_line() max_lines: 16 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                    Label{width: Fill text: charter_version_line() max_lines: 3 draw_text.color: #x65786f draw_text.text_style.font_size: 10}
                                }
                            }
                            // ---- 没上的三条 · 取舍被看见，才能被反驳 ----
                            if drop_count() > 0 {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 4
                                    new_batch: true show_bg: true draw_bg.color: surface2 draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "没上的三条 · 以及为什么" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: drop_line(0) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                    Label{visible: drop_count() > 1 width: Fill text: drop_line(1) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                    Label{visible: drop_count() > 2 width: Fill text: drop_line(2) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                }
                            }
                            // ---- 决策台 · 同一批候选，换一类模型再判一次（Jev 式校准选择） ----
                            // 主编那一版是「给人读的」：导语和理由都是句子。这一版是「给程序用的」：
                            // 每条只回一个档位、一个概率、一个分。两者不一样的地方就是分歧，点一行可读原文。
                            if vd_state != "" {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 5
                                    new_batch: true show_bg: true draw_bg.color: surface2 draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                    padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                                    Label{width: Fill text: "决策台 · 另一类模型只回「选择 + 置信度」" draw_text.color: gold draw_text.text_style: theme.font_bold{font_size: 11}}
                                    Label{width: Fill text: "上面那版写给人读，这一版给程序用：档位只能落进预设四档，掉出去记 unknown，另加 0-100 进刊概率与 0-10 热度分。点一行可打开原报道。" max_lines: 4 draw_text.color: #x7a8098 draw_text.text_style.font_size: 10}
                                    Label{width: Fill text: vd_head_line() max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                    if vd_state == "asking" {
                                        Label{width: Fill text: "决策台正在判…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                                    }
                                    for k v in vd_rows {
                                        GestureView{width: Fill height: Fit on_tap: |x, y| vd_open(k)
                                            RoundedView{width: Fill height: Fit flow: Down spacing: 2
                                                new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 10.0
                                                padding: Inset{top: 9 bottom: 9 left: 11 right: 11}
                                                Label{width: Fill text: vd_row_text(k) max_lines: 3 draw_text.color: #x4b655d draw_text.text_style.font_size: 11}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 20 right: 20 top: 10 bottom: 96}
                        pf_line := Label{visible: false width: Fill text: "" draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 9}}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                            sel_line := Label{width: Fill text: "点任意条目，读这条新闻的来龙去脉" max_lines: 2 draw_text.color: faint draw_text.text_style.font_size: 10}
                            BarBtn{text: "重新开始" on_click: || restart()}
                        }
                    }
                  }
                }
                report_pane := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 16 bottom: 96}
                    report_body := View{width: Fill height: Fit flow: Down spacing: 14
                        on_render: || {
                            let d = report_current()
                            if d == nil {
                                View{width: Fill height: Fit flow: Down spacing: 12
                                    Label{width: Fill text: "这一页暂未恢复，但工作台仍可用。" draw_text.color: ink}
                                    PrimaryBtn{text: "返回工作台" on_click: || report_activate("compose")}
                                }
                            } else {
                                let rows = list_of(d, "rows")
                                View{width: Fill height: Fit flow: Down spacing: 14
                                    Label{width: Fill text: "DAYBREAK / " + report_label(report_focus) draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 11}}
                                    let headline = s_of(d, "cover_head")
                                    if headline == "" { headline = "这一期，读世界。" }
                                    Label{width: Fill text: headline max_lines: 3 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 24}}
                                    Label{width: Fill text: ("" + rows.len()) + " 条线索 · 独立日报 · 阅读状态自动保留" draw_text.color: secondary draw_text.text_style.font_size: 11}
                                    RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 12 right: 12 top: 10 bottom: 10}
                                        show_bg: true draw_bg.color: #xe9eddb draw_bg.border_radius: 12.0
                                        Label{width: Fill text: report_read_line() draw_text.color: soft draw_text.text_style.font_size: 11}
                                        View{width: Fill height: 5 flow: Right spacing: 3
                                            for entry in rows {
                                                SolidView{width: Fill height: 5 draw_bg.color: if report_was_read(s_of(entry, "id")) { #xc58b45 } else { #xd1dbcd }}
                                            }
                                        }
                                    }
                                    if s_of(d, "intro") != "" {
                                        Label{width: Fill text: s_of(d, "intro") max_lines: 4 draw_text.color: soft draw_text.text_style.font_size: 13}
                                    }
                                    if s_of(d, "cover_url") != "" {
                                        Image{width: Fill height: 184 fit: ImageFit.CropToFill src: http_resource(s_of(d, "cover_url"))}
                                    }
                                    SolidView{width: Fill height: 1 draw_bg.color: hair}
                                    Label{width: Fill text: s_of(d, "sources") draw_text.color: secondary draw_text.text_style.font_size: 11}
                                    if s_of(d, "failures") != "" {
                                        Label{width: Fill text: s_of(d, "failures") draw_text.color: accent draw_text.text_style.font_size: 11}
                                    }
                                    for i r in rows {
                                        let rr = r
                                        let why = report_reason(d, r.id)
                                        GestureView{width: Fill height: Fit on_tap: |x, y| open_story(rr)
                                            RoundedView{width: Fill height: Fit flow: Down spacing: 7 padding: Inset{left: 16 right: 16 top: 15 bottom: 15}
                                                draw_bg.color: paper draw_bg.border_color: hair draw_bg.border_size: 1 draw_bg.border_radius: 14
                                                Label{width: Fill text: sky_pad(i + 1) + "  /  " + report_read_tag(r.id) + "  ·  " + row_meta(r) draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 10}}
                                                Label{width: Fill text: r.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                                                if s_of(r, "summary") != "" {
                                                    Label{width: Fill text: s_of(r, "summary") max_lines: 3 draw_text.color: secondary draw_text.text_style.font_size: 12}
                                                }
                                                if why != "" {
                                                    Label{width: Fill text: "主编按语 · " + why draw_text.color: accent draw_text.text_style.font_size: 11}
                                                }
                                                BarBtn{text: "展开这条线索 ↗" on_click: || open_story(rr)}
                                            }
                                        }
                                    }
                                    if list_of(d, "drops").len() > 0 {
                                        Label{text: "也让落选的理由被看见" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                        for r in list_of(d, "drops") {
                                            Label{width: Fill text: s_of(r, "title") + " · " + s_of(r, "why") draw_text.color: secondary draw_text.text_style.font_size: 12}
                                        }
                                    }
                                    Label{width: Fill text: "本机独立存档 · 情报池 / 复盘 / 立场随本期页签切换" draw_text.color: faint draw_text.text_style.font_size: 10}
                                    GhostBtn{text: "＋ 再开新一期" on_click: || report_new()}
                                }
                            }
                        }
                    }
                }
                story_pane := View{visible: false width: Fill height: Fill flow: Down
                    View{width: Fill height: Fit flow: Down spacing: 7 padding: Inset{left: 18 right: 18 top: 8 bottom: 12}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 3
                            BarBtn{text: "‹ 返回" on_click: || close_story()}
                            BarBtn{text: "来信追问" on_click: || iv_kick()}
                            BarBtn{text: "更新解读" on_click: || story_refresh()}
                            story_pos := Label{width: Fill align: Align{x: 1.0} text: "" draw_text.color: faint draw_text.text_style: theme.font_code{font_size: 10}}
                        }
                        story_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                        story_meta := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: theme.font_code{font_size: 10}}
                    }
                    story_sheen := View{width: Fill height: 3
                        on_render: || {
                            View{width: Fill height: 3 show_bg: true new_batch: true
                                draw_bg +: {
                                    progress: instance(1.0)
                                    pixel: fn(){
                                        let sz = self.rect_size
                                        let sdf = Sdf2d.viewport(self.pos * sz)
                                        let p = self.progress
                                        sdf.box(0.0, 1.0, sz.x, 1.0, 0.0)
                                        sdf.fill(#xe0d6bd)
                                        sdf.box(0.0, 0.0, max(1.0, sz.x * p), 2.0, 1.0)
                                        sdf.fill(#xc58d4c)
                                        return sdf.result
                                    }
                                }
                                draw_bg.progress: bar_p
                            }
                        }
                    }
                    ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 14 right: 14 bottom: 88}
                        art_pane := View{width: Fill height: Fit flow: Down
                            on_render: || {
                                if art_on {
                                    View{width: Fill height: Fit flow: Down spacing: 6
                                        Image{width: Fill height: 210 fit: ImageFit.CropToFill src: http_resource(art_url)}
                                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                            Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                            GhostBtn{text: "重画" on_click: || art_retry()}
                                            GhostBtn{text: "收起" on_click: || art_off()}
                                        }
                                    }
                                } else {
                                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                        Label{width: Fill text: art_line() draw_text.color: secondary draw_text.text_style.font_size: 10}
                                        if art_busy {
                                            Label{text: "正在画…" draw_text.color: secondary draw_text.text_style.font_size: 10}
                                        } else {
                                            BarBtn{text: "画一张配图" on_click: || art_retry()}
                                        }
                                    }
                                }
                            }
                        }
                        story_sum_box := RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "官方摘要" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            story_sum := Label{width: Fill text: "" max_lines: 8 draw_text.color: #x4b655d draw_text.text_style.font_size: 13}
                        }
                        RoundedView{width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #x1e1a52 draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "AI 解读" draw_text.color: #x3d7b78 draw_text.text_style: theme.font_bold{font_size: 11}}
                            story_state := Label{width: Fill text: "" draw_text.color: #x61746b draw_text.text_style.font_size: 11}
                            story_ai := Label{width: Fill text: "" max_lines: 20 draw_text.color: ink draw_text.text_style.font_size: 13}
                        }
                        arc_box := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: #x231f4a draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "本报追过这条线索" draw_text.color: #xa4642e draw_text.text_style: theme.font_bold{font_size: 11}}
                            arc_text := Label{width: Fill text: "" max_lines: 6 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                        }
                        story_more_box := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            story_more_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            story_more_text := Label{width: Fill text: "" max_lines: 12 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                        }
                        story_cmt_box := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            story_cmt_head := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            story_cmt_text := Label{width: Fill text: "" max_lines: 16 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                        }
                        // ---- 主编的追问草稿：只写稿，绝不替读者发信 ----
                        iv_pane := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 5
                            new_batch: true show_bg: true draw_bg.color: #xf4efdf draw_bg.border_radius: 16.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 13 bottom: 13 left: 14 right: 14}
                            iv_head := Label{width: Fill text: "" draw_text.color: #xa4642e draw_text.text_style: theme.font_bold{font_size: 11}}
                            iv_text := Label{width: Fill text: "" max_lines: 14 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                            iv_note := Label{width: Fill text: "" max_lines: 3 draw_text.color: #x61736b draw_text.text_style.font_size: 10}
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                                GhostBtn{text: "重写一封" on_click: || iv_kick()}
                                BarBtn{text: "收起" on_click: || iv_reset()}
                            }
                        }
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4
                            new_batch: true show_bg: true draw_bg.color: paper draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                            padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                            Label{width: Fill text: "这条消息的出处" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                            story_src := Label{width: Fill text: "" max_lines: 4 draw_text.color: #x4b655d draw_text.text_style.font_size: 12}
                            story_url := Label{width: Fill text: "" max_lines: 2 draw_text.color: #x61746b draw_text.text_style.font_size: 10}
                        }
                        View{width: Fill height: 44 flow: Right align: Align{y: 0.5} spacing: 8
                            GhostBtn{text: "上一条" on_click: || story_step(-1)}
                            GhostBtn{text: "下一条" on_click: || story_step(1)}
                        }
                    }
                }
            }
        }
        ag_dock := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0}
            // 守夜人的一句话：只有自检发现文案读不出来时才露头。
            // 做成底部一颗会淡出的胶囊 —— 它是一条系统提示，不压在正文上。
            watch_toast := RoundedView{visible: false width: Fill height: Fit flow: Down align: Align{x: 0.5}
                margin: Inset{left: 30 right: 30 bottom: 8} new_batch: true
                draw_bg.color: #xf7eedbee draw_bg.border_radius: 12.0
                draw_bg.border_size: 1.0 draw_bg.border_color: #x9b5d2966
                padding: Inset{top: 7 bottom: 7 left: 12 right: 12}
                watch_line := Label{width: Fill text: "" draw_text.color: #x805427 draw_text.text_style.font_size: 10}
            }
            ag_panel := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 10
                new_batch: true draw_bg.color: #xf6ecd8 draw_bg.border_radius: 22.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xeadbc1
                margin: Inset{left: 12 right: 12} padding: Inset{top: 16 bottom: 16 left: 16 right: 16}
                View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
                    Label{text: "AI 主编" draw_text.color: #x965a28 draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{text: "常驻" draw_text.color: faint draw_text.text_style.font_size: 9}
                    ag_note := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 10}
                    BarBtn{text: "清空" on_click: || ag_clear()}
                    BarBtn{text: "收起" on_click: || ag_toggle()}
                }
                ag_caps := Label{width: Fill text: "" max_lines: 2 draw_text.color: faint draw_text.text_style.font_size: 9}
                ag_iv := Label{visible: false width: Fill text: "" draw_text.color: #x387b62 draw_text.text_style.font_size: 9}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    vc_mic := MicBtn{text: "🎙 说话" on_click: || vc_toggle()}
                    rv_btn := ChipDk{text: "念这一期" on_click: || rv_toggle()}
                    vc_autob := ChipDk{text: "自动朗读" on_click: || vc_toggle_auto()}
                }
                vc_note := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 10}
                ag_log_box := ScrollYView{width: Fill height: 206 flow: Down spacing: 5
                    on_render: || {
                        if ag_log.len() == 0 {
                            Label{width: Fill text: "试着对我说：只看芯片和 AI，生成今天的晨报。" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        }
                        else for e in ag_log {
                            if e.who == "me" {
                                View{width: Fill height: Fit flow: Right
                                    RoundedView{width: Fit height: Fit flow: Down
                                        new_batch: true draw_bg.color: #xddd6c7 draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: hair
                                        padding: Inset{top: 7 bottom: 7 left: 11 right: 11}
                                        Label{width: Fit text: e.text max_lines: 3 draw_text.color: ink draw_text.text_style.font_size: 12}
                                    }
                                }
                            }
                            else if e.who == "tool" {
                                Label{width: Fill text: e.text max_lines: 2 draw_text.color: #x387b62 draw_text.text_style.font_size: 10}
                            }
                            else {
                                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.0}
                                    Label{text: "主编" draw_text.color: #x965a28 draw_text.text_style: theme.font_bold{font_size: 10}}
                                    Label{width: Fill text: e.text max_lines: 3 draw_text.color: soft draw_text.text_style.font_size: 12}
                                }
                            }
                        }
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    ag_in := TextInput{width: Fill height: 42 empty_text: "对主编说一句话…" on_change: |t| ag_set_draft(t)
                        draw_bg +: {color: #xfffaf1 color_hover: #xfffaf1 color_focus: #xf0eadc color_empty: #xfffaf1
                            border_color: #xd1d5c6 border_color_hover: #xd1d5c6 border_color_focus: accent border_color_empty: #xd1d5c6
                            border_radius: 12.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: faint color_empty_hover: faint}
                    }
                    PrimaryBtn{text: "发送" on_click: || ag_send()}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ChipDk{text: "生成今天这份" on_click: || ag_say("生成今天这份晨报")}
                    ChipDk{text: "只看 AI 和芯片" on_click: || ag_say("只看 AI 和芯片，生成今天的晨报")}
                    ChipDk{text: "报过什么" on_click: || ag_say("查一下本报档案里关于 AI 的报道")}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    ChipDk{text: "我的读者画像" on_click: || ag_say("看看我的读者画像，我今天会关心什么")}
                    ChipDk{text: "念给我听" on_click: || rv_toggle()}
                }
            }
            // ---- 底部常驻条：左边是记忆与麦克风，右边是主编的形象和入口 ----
            View{width: Fill height: Fit flow: Right align: Align{x: 1.0 y: 1.0} spacing: 9 padding: Inset{left: 14 right: 14 bottom: 14 top: 6}
                vc_pill_mic := PillBtn{visible: false text: "🎙" on_click: || vc_toggle()}
                arc_pill := Label{width: Fill height: Fit text: "" max_lines: 2 draw_text.color: #x65786f draw_text.text_style.font_size: 9}
                View{width: 8 height: 1}
                // 主编的形象：纯 shader 画出来的小家伙，会呼吸、会眨眼、头顶有晨光
                // 主编的形象 · 咕嘎企鹅（纯 shader 手绘：形体由距离场给出，立体感由法线光照算出）
                //   不加载任何模型、图片或字体，与开场 CG 用同一套距离场手法。
                pet := View{width: 56 height: 56 show_bg: true
                    new_batch: true
                    draw_bg +: {
                        pixel: fn() {
                            let pgT = 0.0
                            let pgSz = self.rect_size
                            let pgP = self.pos * pgSz
                            let pgS = min(pgSz.x, pgSz.y) * 0.5
                            let pgBob = sin(pgT * 2.1) * 0.026
                            let pgSway = sin(pgT * 0.62) * 0.022
                            let pgUx = (pgP.x - pgSz.x * 0.5) / pgS - pgSway
                            let pgUy = (pgP.y - pgSz.y * 0.5) / pgS - pgBob
                            let pgLdir = normalize(vec3(-0.46, -0.70, 0.58))
                            let pgHv = normalize(vec3(-0.26, -0.40, 1.55))
                            let pgBt = fract(pgT * 0.278)
                            let pgShut = 1.0 - smoothstep(0.0 0.055 abs(pgBt - 0.5))
                            let pgEyeK = 1.0 - pgShut * 0.93
                            var pgCol = #x101218
                            var pgA = 0.0
                            let pgq0 = vec2((pgUx - (-0.45)) / 0.12, (pgUy - (0.26)) / 0.24)
                            let pgd0 = length(pgq0)
                            let pgm0 = 1.0 - smoothstep(0.93 1.0 pgd0)
                            let pgz0 = sqrt(max(0.0, 1.0 - pgd0 * pgd0))
                            let pgn0 = normalize(vec3(pgq0.x, pgq0.y, pgz0))
                            let pgl0 = 0.40 + 0.74 * max(0.0, dot(pgn0, pgLdir))
                            let pgc0 = #x2b2f3a * pgl0 + #xffffff * pow(max(0.0, dot(pgn0, pgHv)), 16.0) * 0.2
                            pgCol = pgCol.mix(pgc0, pgm0)
                            pgA = max(pgA, pgm0)
                            let pgq1 = vec2((pgUx - (0.45)) / 0.12, (pgUy - (0.26)) / 0.24)
                            let pgd1 = length(pgq1)
                            let pgm1 = 1.0 - smoothstep(0.93 1.0 pgd1)
                            let pgz1 = sqrt(max(0.0, 1.0 - pgd1 * pgd1))
                            let pgn1 = normalize(vec3(pgq1.x, pgq1.y, pgz1))
                            let pgl1 = 0.40 + 0.74 * max(0.0, dot(pgn1, pgLdir))
                            let pgc1 = #x2b2f3a * pgl1 + #xffffff * pow(max(0.0, dot(pgn1, pgHv)), 16.0) * 0.2
                            pgCol = pgCol.mix(pgc1, pgm1)
                            pgA = max(pgA, pgm1)
                            let pgq2 = vec2((pgUx - (-0.19)) / 0.155, (pgUy - (0.82)) / 0.078)
                            let pgd2 = length(pgq2)
                            let pgm2 = 1.0 - smoothstep(0.93 1.0 pgd2)
                            let pgz2 = sqrt(max(0.0, 1.0 - pgd2 * pgd2))
                            let pgn2 = normalize(vec3(pgq2.x, pgq2.y, pgz2))
                            let pgl2 = 0.40 + 0.74 * max(0.0, dot(pgn2, pgLdir))
                            let pgc2 = #xf59a2e * pgl2 + #xffffff * pow(max(0.0, dot(pgn2, pgHv)), 26.0) * 0.42
                            pgCol = pgCol.mix(pgc2, pgm2)
                            pgA = max(pgA, pgm2)
                            let pgq3 = vec2((pgUx - (0.19)) / 0.155, (pgUy - (0.82)) / 0.078)
                            let pgd3 = length(pgq3)
                            let pgm3 = 1.0 - smoothstep(0.93 1.0 pgd3)
                            let pgz3 = sqrt(max(0.0, 1.0 - pgd3 * pgd3))
                            let pgn3 = normalize(vec3(pgq3.x, pgq3.y, pgz3))
                            let pgl3 = 0.40 + 0.74 * max(0.0, dot(pgn3, pgLdir))
                            let pgc3 = #xf59a2e * pgl3 + #xffffff * pow(max(0.0, dot(pgn3, pgHv)), 26.0) * 0.42
                            pgCol = pgCol.mix(pgc3, pgm3)
                            pgA = max(pgA, pgm3)
                            let pgq4 = vec2((pgUx - (0.0)) / 0.46, (pgUy - (0.3)) / 0.5)
                            let pgd4 = length(pgq4)
                            let pgm4 = 1.0 - smoothstep(0.93 1.0 pgd4)
                            let pgz4 = sqrt(max(0.0, 1.0 - pgd4 * pgd4))
                            let pgn4 = normalize(vec3(pgq4.x, pgq4.y, pgz4))
                            let pgl4 = 0.40 + 0.74 * max(0.0, dot(pgn4, pgLdir))
                            let pgc4 = #x2b2f3a * pgl4 + #xffffff * pow(max(0.0, dot(pgn4, pgHv)), 16.0) * 0.3
                            pgCol = pgCol.mix(pgc4, pgm4)
                            pgA = max(pgA, pgm4)
                            let pgq5 = vec2((pgUx - (0.0)) / 0.3, (pgUy - (0.345)) / 0.36)
                            let pgd5 = length(pgq5)
                            let pgm5 = 1.0 - smoothstep(0.93 1.0 pgd5)
                            let pgz5 = sqrt(max(0.0, 1.0 - pgd5 * pgd5))
                            let pgn5 = normalize(vec3(pgq5.x, pgq5.y, pgz5))
                            let pgl5 = 0.40 + 0.74 * max(0.0, dot(pgn5, pgLdir))
                            let pgc5 = #xf5f5f7 * pgl5 + #xffffff * pow(max(0.0, dot(pgn5, pgHv)), 18.0) * 0.24
                            pgCol = pgCol.mix(pgc5, pgm5)
                            pgA = max(pgA, pgm5)
                            let pgq6 = vec2((pgUx - (0.0)) / 0.44, (pgUy - (-0.42)) / 0.4)
                            let pgd6 = length(pgq6)
                            let pgm6 = 1.0 - smoothstep(0.93 1.0 pgd6)
                            let pgz6 = sqrt(max(0.0, 1.0 - pgd6 * pgd6))
                            let pgn6 = normalize(vec3(pgq6.x, pgq6.y, pgz6))
                            let pgl6 = 0.40 + 0.74 * max(0.0, dot(pgn6, pgLdir))
                            let pgc6 = #x2b2f3a * pgl6 + #xffffff * pow(max(0.0, dot(pgn6, pgHv)), 16.0) * 0.3
                            pgCol = pgCol.mix(pgc6, pgm6)
                            pgA = max(pgA, pgm6)
                            let pgq7 = vec2((pgUx - (0.0)) / 0.32, (pgUy - (-0.36)) / 0.3)
                            let pgd7 = length(pgq7)
                            let pgm7 = 1.0 - smoothstep(0.93 1.0 pgd7)
                            let pgz7 = sqrt(max(0.0, 1.0 - pgd7 * pgd7))
                            let pgn7 = normalize(vec3(pgq7.x, pgq7.y, pgz7))
                            let pgl7 = 0.40 + 0.74 * max(0.0, dot(pgn7, pgLdir))
                            let pgc7 = #xf5f5f7 * pgl7 + #xffffff * pow(max(0.0, dot(pgn7, pgHv)), 18.0) * 0.24
                            pgCol = pgCol.mix(pgc7, pgm7)
                            pgA = max(pgA, pgm7)
                            let pgq8 = vec2((pgUx - (0.0)) / 0.11, (pgUy - (-0.295)) / 0.078)
                            let pgd8 = length(pgq8)
                            let pgm8 = 1.0 - smoothstep(0.93 1.0 pgd8)
                            let pgz8 = sqrt(max(0.0, 1.0 - pgd8 * pgd8))
                            let pgn8 = normalize(vec3(pgq8.x, pgq8.y, pgz8))
                            let pgl8 = 0.40 + 0.74 * max(0.0, dot(pgn8, pgLdir))
                            let pgc8 = #xf59a2e * pgl8 + #xffffff * pow(max(0.0, dot(pgn8, pgHv)), 30.0) * 0.5
                            pgCol = pgCol.mix(pgc8, pgm8)
                            pgA = max(pgA, pgm8)
                            let pgq9 = vec2((pgUx - (-0.165)) / 0.072, (pgUy - (-0.47)) / (0.088 * pgEyeK))
                            let pgd9 = length(pgq9)
                            let pgm9 = 1.0 - smoothstep(0.93 1.0 pgd9)
                            let pgz9 = sqrt(max(0.0, 1.0 - pgd9 * pgd9))
                            let pgn9 = normalize(vec3(pgq9.x, pgq9.y, pgz9))
                            let pgl9 = 0.40 + 0.74 * max(0.0, dot(pgn9, pgLdir))
                            let pgc9 = #x14161c * pgl9 + #xffffff * pow(max(0.0, dot(pgn9, pgHv)), 40.0) * 0.55
                            pgCol = pgCol.mix(pgc9, pgm9)
                            pgA = max(pgA, pgm9)
                            let pgq10 = vec2((pgUx - (0.165)) / 0.072, (pgUy - (-0.47)) / (0.088 * pgEyeK))
                            let pgd10 = length(pgq10)
                            let pgm10 = 1.0 - smoothstep(0.93 1.0 pgd10)
                            let pgz10 = sqrt(max(0.0, 1.0 - pgd10 * pgd10))
                            let pgn10 = normalize(vec3(pgq10.x, pgq10.y, pgz10))
                            let pgl10 = 0.40 + 0.74 * max(0.0, dot(pgn10, pgLdir))
                            let pgc10 = #x14161c * pgl10 + #xffffff * pow(max(0.0, dot(pgn10, pgHv)), 40.0) * 0.55
                            pgCol = pgCol.mix(pgc10, pgm10)
                            pgA = max(pgA, pgm10)
                            let pgq11 = vec2((pgUx - (-0.135)) / 0.026, (pgUy - (-0.512)) / (0.026 * pgEyeK))
                            let pgd11 = length(pgq11)
                            let pgm11 = 1.0 - smoothstep(0.93 1.0 pgd11)
                            let pgz11 = sqrt(max(0.0, 1.0 - pgd11 * pgd11))
                            let pgn11 = normalize(vec3(pgq11.x, pgq11.y, pgz11))
                            let pgl11 = 0.40 + 0.74 * max(0.0, dot(pgn11, pgLdir))
                            let pgc11 = #xffffff * pgl11
                            pgCol = pgCol.mix(pgc11, pgm11)
                            pgA = max(pgA, pgm11)
                            let pgq12 = vec2((pgUx - (0.135)) / 0.026, (pgUy - (-0.512)) / (0.026 * pgEyeK))
                            let pgd12 = length(pgq12)
                            let pgm12 = 1.0 - smoothstep(0.93 1.0 pgd12)
                            let pgz12 = sqrt(max(0.0, 1.0 - pgd12 * pgd12))
                            let pgn12 = normalize(vec3(pgq12.x, pgq12.y, pgz12))
                            let pgl12 = 0.40 + 0.74 * max(0.0, dot(pgn12, pgLdir))
                            let pgc12 = #xffffff * pgl12
                            pgCol = pgCol.mix(pgc12, pgm12)
                            pgA = max(pgA, pgm12)
                            let pghd = length(vec2(pgUx / 0.360, (pgUy + 0.920) / 0.105))
                            let pgring = (1.0 - smoothstep(0.0 0.16 abs(pghd - 1.0))) * 0.88
                            pgCol = pgCol.mix(#xffd39a, pgring)
                            pgA = max(pgA, pgring)
                            return vec4(pgCol.x * pgA, pgCol.y * pgA, pgCol.z * pgA, pgA)
                        }
                    }
                }
                ag_pill := PillBtn{text: "● AI 主编" on_click: || ag_toggle()}
            }
        }
        // ---- 片头「睁眼」：夜里画一条地平线 → 点燃 → 夜色从地平线向上下张开，露出同一条地平线 ----
        cg := View{width: Fill height: Fill flow: Overlay
            cg_veil := SolidView{width: Fill height: Fill draw_bg.color: #xf7f0e1}
            cg_layer := View{width: Fill height: Fill flow: Overlay
                on_render: || {
                    View{width: Fill height: Fill show_bg: true new_batch: true
                        draw_bg +: {
                            rise: instance(0.0) reveal: instance(0.0) horizon: instance(235.0)
                            pixel: fn(){
                                let sz = self.rect_size
                                let p = self.pos * sz
                                let hy = self.horizon
                                let above = 1.0 - smoothstep(hy - 1.0, hy + 1.0, p.y)
                                let rad = min(45.0, sz.x * 0.11)
                                let sx = sz.x * 0.82
                                let sy = hy + rad * 0.75 - self.rise * rad * 2.20
                                let distance = length(p - vec2(sx, sy))
                                var c = #xe8eddb.mix(#xffd39b, pow(clamp(p.y / max(1.0, hy), 0.0, 1.0), 1.55))
                                let halo = exp(-max(distance - rad, 0.0) / 45.0)
                                c = c.mix(#xffbb76, halo * above * 0.25)
                                let disc = 1.0 - smoothstep(rad - 0.8, rad + 0.8, distance)
                                c = c.mix(#xffffdf, disc * above)
                                let depth = clamp((p.y - hy) / max(1.0, sz.y - hy), 0.0, 1.0)
                                let sea = #x87b4a1.mix(#xf0f1dc, pow(depth, 0.70))
                                c = c.mix(sea, 1.0 - above)
                                let wave = 0.5 + 0.5 * sin((p.y - hy) * 0.45 + sin(p.x * 0.03) * 1.8 - self.rise * 4.0)
                                let glow = exp(-abs(p.x - sx) / (20.0 + depth * 50.0)) * exp(-depth * 3.8) * wave
                                c = c.mix(#xffdda0, glow * (1.0 - above) * self.rise * 0.55)
                                let grain = fract(sin(dot(floor(p), vec2(12.9898, 78.233))) * 43758.54)
                                c = c.mix(#xf0e5ce, grain * 0.025)
                                // 晨光印刷：横向纸层依次揭开，水面折光沿纸边行进；无星星。
                                let paper_depth = p.y + sin(p.x / max(1.0, sz.x) * 3.14159) * 24.0
                                let opening = self.reveal * (sz.y + 100.0) - 45.0
                                let mask = smoothstep(opening - 18.0, opening + 18.0, paper_depth)
                                let present = step(0.001, self.reveal)
                                let lid = 1.0 - present + present * mask
                                let fold = exp(-abs(paper_depth - opening) / 5.0) * self.reveal * (1.0 - self.reveal) * 0.85
                                let alpha = clamp(max(lid, fold), 0.0, 1.0)
                                c = c.mix(#xffefc9, fold)
                                return vec4(c.x * alpha, c.y * alpha, c.z * alpha, alpha)
                            }
                        }
                        draw_bg.rise: cg_g draw_bg.reveal: cg_c draw_bg.horizon: cg_hy()
                    }
                    View{width: Fill height: Fill flow: Down padding: Inset{left: 28 right: 28 top: 32 bottom: 28} spacing: 13
                        Label{text: "晨报 / DAYBREAK" draw_text.color: vec4(0.23, 0.39, 0.33, cg_txt * cg_a) draw_text.text_style: theme.font_code{font_size: 12}}
                        View{width: Fill height: Fit flow: Down margin: Inset{top: (1.0 - cg_g) * 14.0}
                            Label{width: Fill text: "让今天，\n从一束光开始。" draw_text.color: vec4(0.15, 0.25, 0.21, cg_txt * cg_a) draw_text.text_style: theme.font_bold{font_size: 35}}
                        }
                        Label{width: Fill text: cg_hint() draw_text.color: vec4(0.36, 0.43, 0.36, cg_txt * cg_a) draw_text.text_style.font_size: 12}
                        View{width: Fill height: Fill}
                        Label{width: Fill text: "轻点，跳过片头 · 直接读报  ↗" draw_text.color: vec4(0.24, 0.39, 0.32, cg_txt * cg_a) draw_text.text_style.font_size: 11}
                    }
                }
            }
            GestureView{width: Fill height: Fill on_tap: |x, y| cg_off()}
        }
    }
    tile: RoundedView{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 6
        new_batch: true show_bg: true draw_bg.color: ground draw_bg.border_radius: 0.0
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{width: Fill text: "晨报卡" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
            Label{text: sky_issue() draw_text.color: gold draw_text.text_style: theme.font_code{font_size: 10}}
        }
        Label{width: Fill text: "一句话说出想读什么，日出前编好一份可核验的晨报。" max_lines: 3 draw_text.color: soft draw_text.text_style.font_size: 12}
    }
}
