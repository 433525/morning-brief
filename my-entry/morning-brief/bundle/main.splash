// ---- 浏览器式栏目标签 (Browser Tab)——上圆下平，坐在一条水线上；亮着的那格
//      顶上一线天光、脚下一道金水线，像浏览器里被选中的那页。全宽等分，不会挤出去。
let TabActive = WaterBtn{width: Fill height: 40 margin: 0 padding: Inset{left: 4 right: 4} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {hover: instance(0.0) down: instance(0.0) pixel: fn(){
        let sz = self.rect_size
        let sdf = Sdf2d.viewport(self.pos * sz)
        let d = length(self.pos * sz - sz * 0.5)
        let reach = max(sz.x, sz.y) * 0.8
        let h = self.hover
        let k = self.down
        let hr = exp(-pow((d - h * reach) / 6.0, 2.0)) * 4.0 * h * (1.0 - h)
        let kr = exp(-pow((d - k * reach) / 6.0, 2.0)) * 4.0 * k * (1.0 - k)
        var c = #xf7e8c8
        c = c.mix(#xffefd3, h * 0.25)
        c = c.mix(#xa9cbb6, clamp(hr * 0.24 + kr * 0.38, 0.0, 1.0))
        sdf.box(1.0, 1.0, sz.x - 2.0, sz.y - 2.0, 10.0)
        sdf.fill(c)
        sdf.box(12.0, sz.y - 3.0, sz.x - 24.0, 2.0, 1.0)
        sdf.fill(#xb1783c)
        return sdf.result
    }}
    draw_text +: {color: #x315749 color_hover: #x244c3e color_down: #x244c3e text_style: theme.font_bold{font_size: 11}}
}
let IssueActive = WaterBtn{width: Fit height: 44 margin: 0 padding: Inset{left: 18 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {hover: instance(0.0) down: instance(0.0) pixel: fn(){
        let sz = self.rect_size
        let sdf = Sdf2d.viewport(self.pos * sz)
        let d = length(self.pos * sz - vec2(sz.x * 0.5, sz.y * 0.72))
        let h = self.hover
        let k = self.down
        let radius = max(sz.x, sz.y) * 0.78
        let pulse = exp(-pow((d - h * radius) / 7.0, 2.0)) * 4.0 * h * (1.0 - h)
        let touch = exp(-pow((d - k * radius) / 7.0, 2.0)) * 4.0 * k * (1.0 - k)
        var c = #xfffaf1
        c = c.mix(#xd3e2cd, clamp(pulse * 0.24 + touch * 0.33, 0.0, 1.0))
        sdf.box(0.8, 1.0, sz.x - 1.6, sz.y + 7.0, 11.0)
        sdf.fill(c)
        sdf.stroke(#xd6c7a9, 0.8)
        sdf.circle(8.5, sz.y * 0.5, 2.2)
        sdf.fill(#xd59748)
        sdf.box(15.0, sz.y - 3.0, sz.x - 28.0, 2.0, 1.0)
        sdf.fill(#xc48a43)
        return sdf.result
    }}
    draw_text +: {color: #x31594b color_hover: #x31594b color_down: #x31594b text_style: theme.font_code{font_size: 10}}
}
